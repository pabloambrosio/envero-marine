// envero-marine — schema actual de Supabase (public)
// Pegar en https://dbdiagram.io/d para visualizar.
// Fuente de verdad: supabase/migrations/*.sql

Project envero_marine {
  database_type: 'PostgreSQL'
  Note: 'Schema reducido: única tabla appointment. Sin staff con roles (admin único fijo en auth.users), sin client/quiz/message.'
}

Enum appointment_status {
  pending
  confirmed
  cancelled
}

Table appointment {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  email text [not null]
  phone text [not null]
  appointment_date timestamptz [not null]
  status appointment_status [not null, default: 'pending']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    status [name: 'idx_appointment_status']
    appointment_date [name: 'idx_appointment_date']
  }

  Note: '''
    Citas y solicitudes (pending = solicitud). Datos de contacto directos
    (name/email/phone), sin tabla client separada.
    Sin CHECK de horario ni anti-doble-booking en DB — bloqueo solo visual
    en el front por ahora (ver docs/plans/2026-07-22-appointment-only-backend-design.md).
  '''
}

// Nota: el admin es un único usuario fijo en auth.users (schema auth de
// Supabase, no modelado acá), seedeado por scripts/seed-admin.js. Sin
// roles, sin tabla de perfil — cualquier sesión autenticada es el admin.
