---
import Layout from "./Layout.astro";
import "../styles/admin.css";

interface Props {
  title?: string;
}

const { title = "Admin · Envero Marine" } = Astro.props;
const userEmail = Astro.locals.user?.email ?? null;
const isAdmin = Astro.locals.user?.role === "admin";
const pathname = Astro.url.pathname;

const navItems = [
  { num: "00", href: "/admin", label: "Inicio" },
  { num: "01", href: "/admin/appointments", label: "Citas" },
  // El middleware bloquea /admin/users para no-admins; aquí solo se oculta.
  ...(isAdmin ? [{ num: "02", href: "/admin/users", label: "Usuarios" }] : []),
];

function isActive(href: string): boolean {
  if (href === "/admin") return pathname === "/admin";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<Layout title={title} description="Panel administrativo Envero Marine">
  <div class="admin">
    <header class="admin__header">
      <div class="admin__headerInner">
        <a class="admin__brand" href="/admin">
          <span class="admin__brandTag">ENVERO</span>
          <span class="admin__brandSub">Admin</span>
        </a>

        <div class="admin__user">
          {
            userEmail && (
              <a
                class="admin__userEmail"
                href="/admin/profile"
                title={`${userEmail} · Mi perfil`}
              >
                {userEmail}
              </a>
            )
          }
          <button type="button" class="admin__logout" data-admin-logout>
            <span>Cerrar sesión</span>
            <span class="admin__logoutArrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </header>

    <div class="admin__body">
      <aside class="admin__sidebar">
        <nav class="admin__nav" aria-label="Navegación admin">
          <ul class="admin__navList">
            {
              navItems.map((item) => (
                <li class="admin__navItem">
                  <a
                    class:list={[
                      "admin__navLink",
                      { "is-active": isActive(item.href) },
                    ]}
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                  >
                    <span class="admin__navNum">{item.num}</span>
                    <span class="admin__navLabel">{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <main class="admin__main">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script>
  const logoutButton = document.querySelector<HTMLButtonElement>(
    "[data-admin-logout]",
  );
  logoutButton?.addEventListener("click", async () => {
    logoutButton.disabled = true;
    try {
      await fetch("/api/admin/logout", {
        method: "POST",
        credentials: "same-origin",
      });
    } finally {
      window.location.href = "/admin/login";
    }
  });
</script>

<style>
  .admin {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg);
    color: var(--color-ink);
  }

  .admin__header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  .admin__headerInner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .admin__brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--color-ink);
  }

  .admin__brandTag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .admin__brandSub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .admin__user {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
  }

  .admin__userEmail {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    max-width: 28ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.2s var(--ease-out);
  }

  .admin__userEmail:hover {
    color: var(--color-accent);
  }

  .admin__logout {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .admin__logout:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .admin__logout:disabled {
    opacity: 0.5;
    cursor: progress;
  }

  .admin__logoutArrow {
    display: inline-block;
    transition: transform 0.2s var(--ease-out);
  }

  .admin__logout:hover .admin__logoutArrow {
    transform: translateX(3px);
  }

  /* ── body: sidebar + main ─────────────────────────────── */
  .admin__body {
    flex: 1;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0;
  }

  .admin__sidebar {
    border-right: 1px solid var(--color-line);
    padding: var(--space-6) 0;
    position: sticky;
    top: calc(var(--space-4) + var(--space-4) + 1.4em + 1px);
    align-self: start;
  }

  .admin__nav {
    display: flex;
    flex-direction: column;
  }

  .admin__navList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .admin__navItem {
    margin: 0;
  }

  .admin__navLink {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    color: var(--color-ink);
    border-left: 2px solid transparent;
    transition:
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .admin__navLink:hover {
    background-color: rgba(14, 61, 52, 0.03);
  }

  .admin__navLink.is-active {
    border-left-color: var(--color-accent);
    background-color: rgba(217, 132, 42, 0.04);
  }

  .admin__navNum {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--color-ink-muted);
    flex: 0 0 auto;
  }

  .admin__navLink.is-active .admin__navNum {
    color: var(--color-accent);
  }

  .admin__navLabel {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .admin__navLink.is-active .admin__navLabel {
    color: var(--color-primary);
  }

  .admin__main {
    padding: var(--space-7) var(--space-6);
    min-width: 0;
  }

  /* ── responsive ───────────────────────────────────────── */
  @media (max-width: 768px) {
    .admin__headerInner {
      padding: var(--space-3) var(--space-4);
    }

    .admin__userEmail {
      max-width: 14ch;
    }

    .admin__body {
      display: flex;
      flex-direction: column;
    }

    .admin__sidebar {
      position: static;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
      padding: var(--space-2) 0;
      overflow-x: auto;
    }

    .admin__navList {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0;
      padding: 0 var(--space-3);
    }

    .admin__navLink {
      border-left: 0;
      border-bottom: 2px solid transparent;
      padding: var(--space-3) var(--space-4);
      white-space: nowrap;
    }

    .admin__navLink.is-active {
      border-left-color: transparent;
      border-bottom-color: var(--color-accent);
    }

    .admin__main {
      padding: var(--space-5) var(--space-4);
    }
  }
</style>
