---
import { Font } from "astro:assets";
import { resolveLang, useTranslations } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const { title = t("meta.title"), description = t("meta.description") } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" preload />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
