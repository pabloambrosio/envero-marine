---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../admin/guard";
import { adminFetch } from "../../admin/api";
import { formatTimestamp } from "../../admin/format";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;

interface AppUser {
  id: string;
  name: string;
  email: string;
  role: "admin" | "vendor";
  active: boolean;
  created_at: string;
}

interface UsersResponse {
  users: AppUser[];
}

const result = await adminFetch<UsersResponse>(Astro, "/api/admin/users");
const users = result.ok ? result.data.users : [];
---

<AdminLayout title="Usuarios · Admin">
  <section class="adminPage">
    <header class="adminPage__head">
      <div class="adminPage__headRow">
        <div class="adminPage__headTitles">
          <span class="adminPage__eyebrow">01 / Usuarios</span>
          <h1 class="adminPage__title">Usuarios</h1>
        </div>
        <a class="btn btn--primary" href="/admin/users/new">
          <span>Crear usuario</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="adminPage__lead">
        Staff interno del panel: admins y vendors. Editá o desactivá desde la
        tabla; para reactivar un usuario, usá Editar.
      </p>
    </header>

    {
      !result.ok ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">Error</span>
          <h2 class="adminState__title">No pudimos cargar los usuarios.</h2>
          <p class="adminState__lead">
            La API devolvió un error{" "}
            {result.status > 0 ? `(${result.status})` : "de red"}. Reintentá la
            carga.
          </p>
          <a class="adminState__retry" href="/admin/users">
            Reintentar →
          </a>
        </div>
      ) : users.length === 0 ? (
        <div class="adminState">
          <span class="adminState__tag">Vacío</span>
          <h2 class="adminState__title">Sin usuarios cargados.</h2>
          <p class="adminState__lead">
            Cuando se creen, van a aparecer en esta tabla.
          </p>
        </div>
      ) : (
        <div class="adminTable__wrap">
          <table class="adminTable">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th class="is-mono">Rol</th>
                <th class="is-mono">Estado</th>
                <th class="is-mono">Creado</th>
                <th class="is-mono">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {users.map((u) => (
                <tr>
                  <td>{u.name}</td>
                  <td class="is-muted">{u.email}</td>
                  <td class="is-mono">{u.role.toUpperCase()}</td>
                  <td>
                    <span
                      class:list={[
                        "badge",
                        u.active ? "badge--ok" : "badge--off",
                      ]}
                    >
                      {u.active ? "Activo" : "Inactivo"}
                    </span>
                  </td>
                  <td class="is-mono is-tight is-muted">
                    {formatTimestamp(u.created_at)}
                  </td>
                  <td class="is-tight">
                    <span class="adminTable__actions">
                      <a
                        class="adminTable__action"
                        href={`/admin/users/${u.id}/edit`}
                      >
                        Editar
                      </a>
                      {u.active && (
                        <button
                          type="button"
                          class="adminTable__action adminTable__action--danger"
                          data-deactivate-user={u.id}
                          data-user-name={u.name}
                        >
                          Desactivar
                        </button>
                      )}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</AdminLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-deactivate-user]",
  );

  buttons.forEach((button) => {
    button.addEventListener("click", async () => {
      const id = button.dataset.deactivateUser;
      const name = button.dataset.userName ?? "este usuario";
      if (!id) return;

      const confirmed = window.confirm(
        `¿Desactivar a ${name}? Mantiene su historial pero le bloquea el acceso.`,
      );
      if (!confirmed) return;

      button.disabled = true;
      try {
        const response = await fetch(`/api/admin/users/${id}`, {
          method: "DELETE",
          credentials: "same-origin",
        });

        if (response.status === 401) {
          window.location.href = "/admin/login";
          return;
        }
        if (response.status === 403) {
          window.location.href = "/admin/login?reason=forbidden";
          return;
        }
        if (!response.ok) {
          let message = "No pudimos desactivar al usuario.";
          try {
            const payload = await response.json();
            if (payload?.error) message = payload.error;
          } catch {
            // empty body
          }
          window.alert(message);
          button.disabled = false;
          return;
        }

        window.location.reload();
      } catch {
        window.alert("Error de red. Intentá de nuevo.");
        button.disabled = false;
      }
    });
  });
</script>
