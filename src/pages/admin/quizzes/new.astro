---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../admin/guard";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;
---

<AdminLayout title="Nuevo quiz · Admin">
  <section class="adminPage">
    <header class="adminPage__head">
      <span class="adminPage__eyebrow">02 / Quizzes · Nuevo</span>
      <h1 class="adminPage__title">Crear quiz</h1>
      <p class="adminPage__lead">
        Las preguntas se agregan después, desde la vista de detalle del quiz.
      </p>
    </header>

    <form class="adminForm" novalidate data-form-create-quiz>
      <div class="adminForm__alert" data-form-alert hidden>
        <span class="adminForm__alertTag" aria-hidden="true">ERROR</span>
        <span class="adminForm__alertText" data-form-alert-text></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="quiz-title">
          <span class="adminForm__labelText">Título</span>
          <span class="adminForm__labelReq" aria-hidden="true">*</span>
        </label>
        <input
          class="adminForm__input"
          type="text"
          name="title"
          id="quiz-title"
          required
          data-form-input="title"
        />
        <span class="adminForm__fieldError" data-form-error="title"></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="quiz-description">
          <span class="adminForm__labelText">Descripción</span>
          <span class="adminForm__hint">Opcional</span>
        </label>
        <textarea
          class="adminForm__input adminForm__input--textarea"
          name="description"
          id="quiz-description"
          rows="3"
          data-form-input="description"></textarea>
        <span class="adminForm__fieldError" data-form-error="description"></span>
      </div>

      <div class="adminForm__actions">
        <a class="adminForm__cancel" href="/admin/quizzes">Cancelar</a>
        <button
          class="btn btn--primary adminForm__submit"
          type="submit"
          data-form-submit
        >
          <span data-form-submit-label>Crear quiz</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </section>
</AdminLayout>

<script>
  type Issue = { path?: (string | number)[]; message?: string };

  const form = document.querySelector<HTMLFormElement>(
    "[data-form-create-quiz]",
  );
  const alertBox = document.querySelector<HTMLDivElement>("[data-form-alert]");
  const alertText = document.querySelector<HTMLSpanElement>(
    "[data-form-alert-text]",
  );
  const submit = document.querySelector<HTMLButtonElement>("[data-form-submit]");
  const submitLabel = document.querySelector<HTMLSpanElement>(
    "[data-form-submit-label]",
  );
  const fieldErrors = document.querySelectorAll<HTMLSpanElement>(
    "[data-form-error]",
  );
  const inputs = document.querySelectorAll<
    HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
  >("[data-form-input]");

  function clearErrors() {
    if (alertBox) alertBox.hidden = true;
    if (alertText) alertText.textContent = "";
    fieldErrors.forEach((el) => {
      el.textContent = "";
      el.classList.remove("is-visible");
    });
    inputs.forEach((el) => el.classList.remove("has-error"));
  }

  function showAlert(message: string) {
    if (!alertBox || !alertText) return;
    alertText.textContent = message;
    alertBox.hidden = false;
  }

  function showFieldError(field: string, message: string) {
    const errorEl = document.querySelector<HTMLSpanElement>(
      `[data-form-error="${field}"]`,
    );
    const input = document.querySelector<
      HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
    >(`[data-form-input="${field}"]`);
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.add("is-visible");
    }
    if (input) input.classList.add("has-error");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearErrors();

    const data = new FormData(form);
    const description = String(data.get("description") ?? "").trim();
    const payload: { title: string; description?: string } = {
      title: String(data.get("title") ?? "").trim(),
    };
    if (description) payload.description = description;

    if (!submit || !submitLabel) return;
    submit.disabled = true;
    submitLabel.textContent = "Creando…";

    try {
      const response = await fetch("/api/admin/quizzes", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify(payload),
      });

      if (response.ok) {
        window.location.href = "/admin/quizzes";
        return;
      }

      let body: { error?: string; issues?: Issue[] } = {};
      try {
        body = await response.json();
      } catch {
        // empty body
      }

      if (response.status === 401) {
        window.location.href = "/admin/login";
        return;
      }
      if (response.status === 403) {
        window.location.href = "/admin/login?reason=forbidden";
        return;
      }
      if (
        response.status === 400 &&
        Array.isArray(body.issues) &&
        body.issues.length > 0
      ) {
        body.issues.forEach((issue) => {
          const path = issue.path?.[0];
          if (typeof path === "string" && issue.message) {
            showFieldError(path, issue.message);
          }
        });
        showAlert("Revisá los datos del formulario.");
      } else {
        showAlert(body.error ?? "No pudimos crear el quiz.");
      }
    } catch {
      showAlert("Error de red. Verificá tu conexión.");
    } finally {
      submit.disabled = false;
      submitLabel.textContent = "Crear quiz";
    }
  });
</script>

<style>
  .adminForm__input--textarea {
    min-height: 88px;
    resize: vertical;
    padding-top: 0.6rem;
    border-bottom-color: var(--color-line);
    border: 1px solid var(--color-line);
    padding: 0.6rem;
  }

  .adminForm__input--textarea:hover {
    border-color: var(--color-primary-soft);
  }

  .adminForm__input--textarea:focus,
  .adminForm__input--textarea:focus-visible {
    border-color: var(--color-accent);
    border-bottom-width: 2px;
  }
</style>
