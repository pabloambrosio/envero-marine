---
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../../../admin/guard";
import { adminFetch } from "../../../../../admin/api";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/quizzes");

interface AppQuestion {
  id: string;
  position: number;
}
interface QuestionsResponse {
  questions: AppQuestion[];
}

const result = await adminFetch<QuestionsResponse>(
  Astro,
  `/api/admin/quizzes/${id}/questions`,
);
const existing = result.ok ? result.data.questions : [];
const suggestedPosition =
  existing.length > 0
    ? Math.max(...existing.map((q) => q.position)) + 1
    : 1;
---

<AdminLayout title="Nueva pregunta · Admin">
  <section class="adminPage">
    <header class="adminPage__head">
      <span class="adminPage__eyebrow">02 / Quizzes · Nueva pregunta</span>
      <h1 class="adminPage__title">Crear pregunta</h1>
      <p class="adminPage__lead">
        Elegí el tipo y, si corresponde, escribí las opciones. Después podés
        reordenar la pregunta arrastrándola en la lista del quiz.
      </p>
    </header>

    <form
      class="adminForm"
      novalidate
      data-form-question
      data-form-mode="create"
      data-quiz-id={id}
    >
      <div class="adminForm__alert" data-form-alert hidden>
        <span class="adminForm__alertTag" aria-hidden="true">ERROR</span>
        <span class="adminForm__alertText" data-form-alert-text></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="question-position">
          <span class="adminForm__labelText">Posición</span>
          <span class="adminForm__labelReq" aria-hidden="true">*</span>
          <span class="adminForm__hint">Sugerido: {suggestedPosition}</span>
        </label>
        <input
          class="adminForm__input"
          type="number"
          name="position"
          id="question-position"
          min="0"
          step="1"
          required
          value={suggestedPosition}
          data-form-input="position"
        />
        <span class="adminForm__fieldError" data-form-error="position"></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="question-prompt">
          <span class="adminForm__labelText">Pregunta</span>
          <span class="adminForm__labelReq" aria-hidden="true">*</span>
        </label>
        <textarea
          class="adminForm__input adminForm__input--textarea"
          name="prompt"
          id="question-prompt"
          rows="3"
          required
          data-form-input="prompt"></textarea>
        <span class="adminForm__fieldError" data-form-error="prompt"></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="question-type">
          <span class="adminForm__labelText">Tipo</span>
          <span class="adminForm__labelReq" aria-hidden="true">*</span>
        </label>
        <select
          class="adminForm__select"
          name="type"
          id="question-type"
          required
          data-form-input="type"
        >
          <option value="" disabled selected>Seleccioná un tipo</option>
          <option value="single_choice">
            Opción única · una respuesta de N opciones
          </option>
          <option value="multiple_choice">
            Opción múltiple · varias respuestas de N opciones
          </option>
          <option value="open_text">
            Respuesta abierta · sin opciones predefinidas
          </option>
        </select>
        <span class="adminForm__fieldError" data-form-error="type"></span>
      </div>

      <div class="adminForm__field" data-options-field hidden>
        <span class="adminForm__label">
          <span class="adminForm__labelText">Opciones</span>
          <span class="adminForm__labelReq" aria-hidden="true">*</span>
          <span class="adminForm__hint">Mínimo 2</span>
        </span>
        <div class="optionsList" data-options-list>
          <div class="optionsList__row" data-options-row>
            <input
              class="adminForm__input optionsList__input"
              type="text"
              name="option"
              placeholder="Opción 1"
              data-options-input
            />
            <button
              type="button"
              class="optionsList__remove"
              data-options-remove
              aria-label="Quitar opción"
            >
              ✕
            </button>
          </div>
          <div class="optionsList__row" data-options-row>
            <input
              class="adminForm__input optionsList__input"
              type="text"
              name="option"
              placeholder="Opción 2"
              data-options-input
            />
            <button
              type="button"
              class="optionsList__remove"
              data-options-remove
              aria-label="Quitar opción"
            >
              ✕
            </button>
          </div>
        </div>
        <button type="button" class="optionsList__add" data-options-add>
          + Agregar opción
        </button>
        <span class="adminForm__fieldError" data-form-error="options"></span>
      </div>

      <div class="adminForm__field" data-allow-other-field hidden>
        <label class="adminForm__check">
          <input
            class="adminForm__checkBox"
            type="checkbox"
            name="allow_other"
            checked
            data-form-input="allow_other"
          />
          <span>Permite respuesta abierta extra</span>
        </label>
        <p class="adminForm__hint adminForm__hint--block">
          Si está marcado, además de las opciones el cliente puede escribir su
          propia respuesta. Desmarcalo cuando quieras restringirlo a las
          opciones predefinidas.
        </p>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__check">
          <input
            class="adminForm__checkBox"
            type="checkbox"
            name="required"
            checked
            data-form-input="required"
          />
          <span>Requerida</span>
        </label>
      </div>

      <div class="adminForm__actions">
        <a class="adminForm__cancel" href={`/admin/quizzes/${id}`}>Cancelar</a>
        <button
          class="btn btn--primary adminForm__submit"
          type="submit"
          data-form-submit
        >
          <span data-form-submit-label>Crear pregunta</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </section>
</AdminLayout>

<script>
  type Issue = { path?: (string | number)[]; message?: string };
  type QuestionType = "single_choice" | "multiple_choice" | "open_text";

  const CHOICE_TYPES: QuestionType[] = ["single_choice", "multiple_choice"];
  const MIN_OPTIONS = 2;

  const form = document.querySelector<HTMLFormElement>("[data-form-question]");
  if (form) {
    const mode = form.dataset.formMode ?? "create";
    const quizId = form.dataset.quizId;
    const questionId = form.dataset.questionId;

    const alertBox = form.querySelector<HTMLDivElement>("[data-form-alert]");
    const alertText = form.querySelector<HTMLSpanElement>("[data-form-alert-text]");
    const submit = form.querySelector<HTMLButtonElement>("[data-form-submit]");
    const submitLabel = form.querySelector<HTMLSpanElement>("[data-form-submit-label]");

    const typeSelect = form.querySelector<HTMLSelectElement>("[data-form-input='type']");
    const optionsField = form.querySelector<HTMLDivElement>("[data-options-field]");
    const optionsList = form.querySelector<HTMLDivElement>("[data-options-list]");
    const optionsAdd = form.querySelector<HTMLButtonElement>("[data-options-add]");
    const allowOtherField = form.querySelector<HTMLDivElement>("[data-allow-other-field]");
    const allowOtherInput = form.querySelector<HTMLInputElement>("[data-form-input='allow_other']");

    /* ── shared helpers ──────────────────────────────────── */
    function clearErrors() {
      if (alertBox) alertBox.hidden = true;
      if (alertText) alertText.textContent = "";
      form!.querySelectorAll<HTMLSpanElement>("[data-form-error]").forEach((el) => {
        el.textContent = "";
        el.classList.remove("is-visible");
      });
      form!
        .querySelectorAll<HTMLElement>("[data-form-input], [data-options-input]")
        .forEach((el) => el.classList.remove("has-error"));
    }

    function showAlert(message: string) {
      if (!alertBox || !alertText) return;
      alertText.textContent = message;
      alertBox.hidden = false;
    }

    function showFieldError(field: string, message: string) {
      const errorEl = form!.querySelector<HTMLSpanElement>(
        `[data-form-error="${field}"]`,
      );
      const input = form!.querySelector<HTMLElement>(
        `[data-form-input="${field}"]`,
      );
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.add("is-visible");
      }
      if (input) input.classList.add("has-error");
      if (field === "options" && optionsList) {
        optionsList
          .querySelectorAll<HTMLInputElement>("[data-options-input]")
          .forEach((el) => el.classList.add("has-error"));
      }
    }

    /* ── options list management ─────────────────────────── */
    function refreshRemoveButtons() {
      if (!optionsList) return;
      const rows = optionsList.querySelectorAll<HTMLDivElement>("[data-options-row]");
      const removable = rows.length > MIN_OPTIONS;
      rows.forEach((row) => {
        const btn = row.querySelector<HTMLButtonElement>("[data-options-remove]");
        if (btn) btn.disabled = !removable;
      });
    }

    function buildOptionRow(value = ""): HTMLDivElement {
      const row = document.createElement("div");
      row.className = "optionsList__row";
      row.dataset.optionsRow = "";

      const input = document.createElement("input");
      input.type = "text";
      input.name = "option";
      input.className = "adminForm__input optionsList__input";
      input.dataset.optionsInput = "";
      input.value = value;
      input.placeholder = `Opción ${
        (optionsList?.querySelectorAll("[data-options-row]").length ?? 0) + 1
      }`;

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className = "optionsList__remove";
      removeBtn.dataset.optionsRemove = "";
      removeBtn.setAttribute("aria-label", "Quitar opción");
      removeBtn.textContent = "✕";

      row.appendChild(input);
      row.appendChild(removeBtn);
      return row;
    }

    function renumberPlaceholders() {
      if (!optionsList) return;
      const rows = optionsList.querySelectorAll<HTMLDivElement>("[data-options-row]");
      rows.forEach((row, index) => {
        const input = row.querySelector<HTMLInputElement>("[data-options-input]");
        if (input && !input.value) input.placeholder = `Opción ${index + 1}`;
      });
    }

    optionsAdd?.addEventListener("click", () => {
      if (!optionsList) return;
      const row = buildOptionRow();
      optionsList.appendChild(row);
      refreshRemoveButtons();
      row.querySelector<HTMLInputElement>("[data-options-input]")?.focus();
    });

    optionsList?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      const removeBtn = target?.closest<HTMLButtonElement>("[data-options-remove]");
      if (!removeBtn || removeBtn.disabled) return;
      const row = removeBtn.closest<HTMLDivElement>("[data-options-row]");
      row?.remove();
      refreshRemoveButtons();
      renumberPlaceholders();
    });

    /* ── type-driven visibility ──────────────────────────── */
    function ensureMinimumOptions() {
      if (!optionsList) return;
      const current = optionsList.querySelectorAll("[data-options-row]").length;
      for (let i = current; i < MIN_OPTIONS; i++) {
        optionsList.appendChild(buildOptionRow());
      }
      refreshRemoveButtons();
    }

    function applyTypeVisibility() {
      const value = (typeSelect?.value ?? "") as QuestionType | "";
      const isChoice = CHOICE_TYPES.includes(value as QuestionType);
      if (optionsField) optionsField.hidden = !isChoice;
      if (allowOtherField) allowOtherField.hidden = !isChoice;
      if (isChoice) ensureMinimumOptions();
    }

    typeSelect?.addEventListener("change", applyTypeVisibility);
    applyTypeVisibility();
    refreshRemoveButtons();

    /* ── submit ──────────────────────────────────────────── */
    function collectOptions(): string[] {
      if (!optionsList) return [];
      return Array.from(
        optionsList.querySelectorAll<HTMLInputElement>("[data-options-input]"),
      )
        .map((el) => el.value.trim())
        .filter((v) => v.length > 0);
    }

    type Payload = {
      position: number;
      prompt: string;
      type: QuestionType;
      options?: string[];
      allow_other?: boolean;
      required: boolean;
      active?: boolean;
    };

    function buildPayload(): Payload | null {
      const data = new FormData(form!);
      const positionRaw = String(data.get("position") ?? "");
      const positionNum = Number(positionRaw);
      const type = String(data.get("type") ?? "") as QuestionType;

      if (!type) {
        showFieldError("type", "elegí un tipo");
        showAlert("Revisá los datos del formulario.");
        return null;
      }

      const payload: Payload = {
        position: Number.isFinite(positionNum) ? positionNum : 0,
        prompt: String(data.get("prompt") ?? "").trim(),
        type,
        required: data.get("required") === "on",
      };

      if (mode === "edit") {
        payload.active = data.get("active") === "on";
      }

      if (CHOICE_TYPES.includes(type)) {
        const opts = collectOptions();
        if (opts.length < MIN_OPTIONS) {
          showFieldError("options", `mínimo ${MIN_OPTIONS} opciones`);
          showAlert("Revisá los datos del formulario.");
          return null;
        }
        payload.options = opts;
        payload.allow_other = allowOtherInput?.checked ?? true;
      }

      return payload;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!quizId) return;
      clearErrors();

      const payload = buildPayload();
      if (!payload) return;

      const isCreate = mode === "create";
      if (!submit || !submitLabel) return;
      const idleLabel = submitLabel.textContent ?? "";
      submit.disabled = true;
      submitLabel.textContent = isCreate ? "Creando…" : "Guardando…";

      const url = isCreate
        ? `/api/admin/quizzes/${quizId}/questions`
        : `/api/admin/quizzes/${quizId}/questions/${questionId}`;
      const method = isCreate ? "POST" : "PATCH";

      try {
        const response = await fetch(url, {
          method,
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          window.location.href = `/admin/quizzes/${quizId}`;
          return;
        }

        let body: { error?: string; issues?: Issue[] } = {};
        try {
          body = await response.json();
        } catch {
          // empty body
        }

        if (response.status === 401) {
          window.location.href = "/admin/login";
          return;
        }
        if (response.status === 403) {
          window.location.href = "/admin/login?reason=forbidden";
          return;
        }
        if (response.status === 404) {
          showAlert("Esta pregunta ya no existe.");
        } else if (
          response.status === 400 &&
          Array.isArray(body.issues) &&
          body.issues.length > 0
        ) {
          body.issues.forEach((issue) => {
            const path = issue.path?.[0];
            if (typeof path === "string" && issue.message) {
              showFieldError(path, issue.message);
            }
          });
          showAlert("Revisá los datos del formulario.");
        } else {
          showAlert(body.error ?? "No pudimos guardar la pregunta.");
        }
      } catch {
        showAlert("Error de red. Verificá tu conexión.");
      } finally {
        submit.disabled = false;
        submitLabel.textContent = idleLabel;
      }
    });
  }
</script>

<style>
  .adminForm__input--textarea {
    min-height: 88px;
    resize: vertical;
    border: 1px solid var(--color-line);
    padding: 0.6rem;
  }

  .adminForm__input--textarea:hover {
    border-color: var(--color-primary-soft);
  }

  .adminForm__input--textarea:focus,
  .adminForm__input--textarea:focus-visible {
    border-color: var(--color-accent);
    border-bottom-width: 2px;
  }

  .adminForm__hint--block {
    display: block;
    margin: 0;
    text-transform: none;
    letter-spacing: 0.02em;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--color-ink-muted);
  }

  /* options list (choice questions only) */
  .optionsList {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .optionsList__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3);
    align-items: center;
  }

  .optionsList__input {
    width: 100%;
  }

  .optionsList__remove {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    background: transparent;
    border: 1px solid var(--color-line);
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .optionsList__remove:hover:not(:disabled) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .optionsList__remove:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .optionsList__add {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    cursor: pointer;
    transition: color 0.2s var(--ease-out);
  }

  .optionsList__add:hover {
    color: var(--color-accent-soft);
  }
</style>
