---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../../admin/guard";
import { adminFetch } from "../../../../admin/api";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/quizzes");

interface AppQuiz {
  id: string;
  title: string;
  description: string | null;
  version: number;
  active: boolean;
  created_at: string;
  updated_at: string;
}

interface QuizResponse {
  quiz: AppQuiz;
}

const result = await adminFetch<QuizResponse>(
  Astro,
  `/api/admin/quizzes/${id}`,
);
const isNotFound = !result.ok && result.status === 404;
const quiz = result.ok ? result.data.quiz : null;
---

<AdminLayout title="Editar quiz · Admin">
  <section class="adminPage">
    <header class="adminPage__head">
      <span class="adminPage__eyebrow">02 / Quizzes · Editar</span>
      <h1 class="adminPage__title">Editar quiz</h1>
      <p class="adminPage__lead">
        Cambios en título y descripción son inmediatos. Desactivar el quiz no
        borra sus preguntas.
      </p>
    </header>

    {
      isNotFound ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">No encontrado</span>
          <h2 class="adminState__title">Quiz no encontrado.</h2>
          <p class="adminState__lead">
            Puede haber sido borrado o el ID es incorrecto.
          </p>
          <a class="adminState__retry" href="/admin/quizzes">
            Volver a la lista →
          </a>
        </div>
      ) : !result.ok || !quiz ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">Error</span>
          <h2 class="adminState__title">No pudimos cargar el quiz.</h2>
          <p class="adminState__lead">
            La API devolvió un error
            {result.ok === false && result.status > 0
              ? ` (${result.status})`
              : " de red"}
            . Reintentá la carga.
          </p>
          <a class="adminState__retry" href={`/admin/quizzes/${id}/edit`}>
            Reintentar →
          </a>
        </div>
      ) : (
        <form
          class="adminForm"
          novalidate
          data-form-edit-quiz
          data-quiz-id={quiz.id}
        >
          <div class="adminForm__alert" data-form-alert hidden>
            <span class="adminForm__alertTag" aria-hidden="true">
              ERROR
            </span>
            <span class="adminForm__alertText" data-form-alert-text />
          </div>

          <div class="adminForm__field">
            <label class="adminForm__label" for="quiz-title">
              <span class="adminForm__labelText">Título</span>
              <span class="adminForm__labelReq" aria-hidden="true">
                *
              </span>
            </label>
            <input
              class="adminForm__input"
              type="text"
              name="title"
              id="quiz-title"
              required
              value={quiz.title}
              data-form-input="title"
            />
            <span class="adminForm__fieldError" data-form-error="title" />
          </div>

          <div class="adminForm__field">
            <label class="adminForm__label" for="quiz-description">
              <span class="adminForm__labelText">Descripción</span>
              <span class="adminForm__hint">Opcional</span>
            </label>
            <textarea
              class="adminForm__input adminForm__input--textarea"
              name="description"
              id="quiz-description"
              rows="3"
              data-form-input="description">{quiz.description ?? ""}</textarea>
            <span
              class="adminForm__fieldError"
              data-form-error="description"
            />
          </div>

          <div class="adminForm__field">
            <label class="adminForm__check">
              <input
                class="adminForm__checkBox"
                type="checkbox"
                name="active"
                checked={quiz.active}
                data-form-input="active"
              />
              <span>Quiz activo</span>
            </label>
            <span class="adminForm__fieldError" data-form-error="active" />
          </div>

          <div class="adminForm__actions">
            <a class="adminForm__cancel" href="/admin/quizzes">
              Cancelar
            </a>
            <button
              class="btn btn--primary adminForm__submit"
              type="submit"
              data-form-submit
            >
              <span data-form-submit-label>Guardar cambios</span>
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            </button>
          </div>
        </form>
      )
    }
  </section>
</AdminLayout>

<script>
  type Issue = { path?: (string | number)[]; message?: string };

  const form = document.querySelector<HTMLFormElement>("[data-form-edit-quiz]");
  if (form) {
    const quizId = form.dataset.quizId;
    const alertBox = form.querySelector<HTMLDivElement>("[data-form-alert]");
    const alertText = form.querySelector<HTMLSpanElement>(
      "[data-form-alert-text]",
    );
    const submit = form.querySelector<HTMLButtonElement>("[data-form-submit]");
    const submitLabel = form.querySelector<HTMLSpanElement>(
      "[data-form-submit-label]",
    );
    const fieldErrors = form.querySelectorAll<HTMLSpanElement>(
      "[data-form-error]",
    );
    const inputs = form.querySelectorAll<
      HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
    >("[data-form-input]");

    function clearErrors() {
      if (alertBox) alertBox.hidden = true;
      if (alertText) alertText.textContent = "";
      fieldErrors.forEach((el) => {
        el.textContent = "";
        el.classList.remove("is-visible");
      });
      inputs.forEach((el) => el.classList.remove("has-error"));
    }

    function showAlert(message: string) {
      if (!alertBox || !alertText) return;
      alertText.textContent = message;
      alertBox.hidden = false;
    }

    function showFieldError(field: string, message: string) {
      const errorEl = form!.querySelector<HTMLSpanElement>(
        `[data-form-error="${field}"]`,
      );
      const input = form!.querySelector<
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >(`[data-form-input="${field}"]`);
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.add("is-visible");
      }
      if (input) input.classList.add("has-error");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!quizId) return;
      clearErrors();

      const data = new FormData(form);
      const description = String(data.get("description") ?? "").trim();
      const payload: {
        title: string;
        description: string | null;
        active: boolean;
      } = {
        title: String(data.get("title") ?? "").trim(),
        description: description.length > 0 ? description : null,
        active: data.get("active") === "on",
      };

      if (!submit || !submitLabel) return;
      submit.disabled = true;
      submitLabel.textContent = "Guardando…";

      try {
        const response = await fetch(`/api/admin/quizzes/${quizId}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          window.location.href = "/admin/quizzes";
          return;
        }

        let body: { error?: string; issues?: Issue[] } = {};
        try {
          body = await response.json();
        } catch {
          // empty body
        }

        if (response.status === 401) {
          window.location.href = "/admin/login";
          return;
        }
        if (response.status === 403) {
          window.location.href = "/admin/login?reason=forbidden";
          return;
        }
        if (response.status === 404) {
          showAlert("Este quiz ya no existe.");
        } else if (
          response.status === 400 &&
          Array.isArray(body.issues) &&
          body.issues.length > 0
        ) {
          body.issues.forEach((issue) => {
            const path = issue.path?.[0];
            if (typeof path === "string" && issue.message) {
              showFieldError(path, issue.message);
            }
          });
          showAlert("Revisá los datos del formulario.");
        } else {
          showAlert(body.error ?? "No pudimos guardar los cambios.");
        }
      } catch {
        showAlert("Error de red. Verificá tu conexión.");
      } finally {
        submit.disabled = false;
        submitLabel.textContent = "Guardar cambios";
      }
    });
  }
</script>

<style>
  .adminForm__input--textarea {
    min-height: 88px;
    resize: vertical;
    padding-top: 0.6rem;
    border-bottom-color: var(--color-line);
    border: 1px solid var(--color-line);
    padding: 0.6rem;
  }

  .adminForm__input--textarea:hover {
    border-color: var(--color-primary-soft);
  }

  .adminForm__input--textarea:focus,
  .adminForm__input--textarea:focus-visible {
    border-color: var(--color-accent);
    border-bottom-width: 2px;
  }
</style>
