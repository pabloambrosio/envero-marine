---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../../admin/guard";
import { adminFetch } from "../../../../admin/api";
import { formatTimestamp } from "../../../../admin/format";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/quizzes");

interface AppQuiz {
  id: string;
  title: string;
  description: string | null;
  version: number;
  active: boolean;
  created_at: string;
  updated_at: string;
}

type QuestionType = "single_choice" | "multiple_choice" | "open_text";

interface AppQuestion {
  id: string;
  quiz_id: string;
  position: number;
  prompt: string;
  type: QuestionType;
  options: string[];
  allow_other: boolean;
  required: boolean;
  active: boolean;
}

interface QuizResponse {
  quiz: AppQuiz;
}
interface QuestionsResponse {
  questions: AppQuestion[];
}

const [quizResult, questionsResult] = await Promise.all([
  adminFetch<QuizResponse>(Astro, `/api/admin/quizzes/${id}`),
  adminFetch<QuestionsResponse>(Astro, `/api/admin/quizzes/${id}/questions`),
]);

const isNotFound = !quizResult.ok && quizResult.status === 404;
const quiz = quizResult.ok ? quizResult.data.quiz : null;
const questions = questionsResult.ok ? questionsResult.data.questions : [];
const questionsFailed = !questionsResult.ok;

const TYPE_LABELS: Record<QuestionType, string> = {
  single_choice: "Opción única",
  multiple_choice: "Opción múltiple",
  open_text: "Abierta",
};

function questionMeta(q: AppQuestion): string {
  if (q.type === "open_text") return "Respuesta libre";
  const count = `${q.options.length} ${q.options.length === 1 ? "opción" : "opciones"}`;
  return q.allow_other ? `${count} · permite otra` : `${count} · cerrada`;
}
---

<AdminLayout title={quiz ? `${quiz.title} · Admin` : "Quiz · Admin"}>
  <section class="adminPage">
    <header class="adminPage__head">
      <div class="adminPage__headRow">
        <div class="adminPage__headTitles">
          <span class="adminPage__eyebrow">02 / Quizzes · Detalle</span>
          <h1 class="adminPage__title">{quiz ? quiz.title : "Quiz"}</h1>
        </div>
        {
          quiz && (
            <a class="btn btn--primary" href={`/admin/quizzes/${quiz.id}/edit`}>
              <span>Editar quiz</span>
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
      </div>
    </header>

    {
      isNotFound ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">No encontrado</span>
          <h2 class="adminState__title">Quiz no encontrado.</h2>
          <p class="adminState__lead">
            Puede haber sido borrado o el ID es incorrecto.
          </p>
          <a class="adminState__retry" href="/admin/quizzes">
            Volver a la lista →
          </a>
        </div>
      ) : !quizResult.ok || !quiz ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">Error</span>
          <h2 class="adminState__title">No pudimos cargar el quiz.</h2>
          <p class="adminState__lead">
            La API devolvió un error
            {quizResult.ok === false && quizResult.status > 0
              ? ` (${quizResult.status})`
              : " de red"}
            . Reintentá la carga.
          </p>
          <a class="adminState__retry" href={`/admin/quizzes/${id}`}>
            Reintentar →
          </a>
        </div>
      ) : (
        <div class="quizDetail">
          <dl class="quizDetail__list">
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Título</dt>
              <dd class="quizDetail__value">{quiz.title}</dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Descripción</dt>
              <dd class:list={["quizDetail__value", { "is-muted": !quiz.description }]}>
                {quiz.description ?? "Sin descripción"}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Versión</dt>
              <dd class="quizDetail__value is-mono">v{quiz.version}</dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Estado</dt>
              <dd class="quizDetail__value">
                <span class:list={["badge", quiz.active ? "badge--ok" : "badge--off"]}>
                  {quiz.active ? "Activo" : "Inactivo"}
                </span>
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">ID</dt>
              <dd class="quizDetail__value is-mono is-muted" title={quiz.id}>
                {quiz.id}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Creado</dt>
              <dd class="quizDetail__value is-mono is-muted">
                {formatTimestamp(quiz.created_at)}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Actualizado</dt>
              <dd class="quizDetail__value is-mono is-muted">
                {formatTimestamp(quiz.updated_at)}
              </dd>
            </div>
          </dl>

          <div class="questions">
            <header class="questions__head">
              <div class="questions__headTitles">
                <span class="adminPage__eyebrow">Preguntas</span>
                <h2 class="questions__title">
                  {questions.length === 0
                    ? "Sin preguntas todavía"
                    : `${questions.length} pregunta${questions.length === 1 ? "" : "s"}`}
                </h2>
              </div>
              <a
                class="btn btn--primary"
                href={`/admin/quizzes/${quiz.id}/questions/new`}
              >
                <span>Crear pregunta</span>
                <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </header>

            {
              questionsFailed ? (
                <div class="adminState adminState--error">
                  <span class="adminState__tag">Error</span>
                  <h3 class="adminState__title">
                    No pudimos cargar las preguntas.
                  </h3>
                  <p class="adminState__lead">
                    La API devolvió un error
                    {questionsResult.ok === false && questionsResult.status > 0
                      ? ` (${questionsResult.status})`
                      : " de red"}
                    . Reintentá la carga.
                  </p>
                  <a class="adminState__retry" href={`/admin/quizzes/${quiz.id}`}>
                    Reintentar →
                  </a>
                </div>
              ) : questions.length === 0 ? (
                <div class="adminState">
                  <span class="adminState__tag">Vacío</span>
                  <h3 class="adminState__title">
                    Este quiz todavía no tiene preguntas.
                  </h3>
                  <p class="adminState__lead">
                    Creá la primera con el botón de arriba. Después podés
                    reordenarlas arrastrando.
                  </p>
                </div>
              ) : (
                <div
                  class="adminTable__wrap"
                  data-questions-table
                  data-quiz-id={quiz.id}
                >
                  <table class="adminTable">
                    <thead>
                      <tr>
                        <th aria-label="Reordenar" />
                        <th class="is-mono">Pos.</th>
                        <th>Pregunta</th>
                        <th class="is-mono">Tipo</th>
                        <th class="is-mono">Requerida</th>
                        <th class="is-mono">Estado</th>
                        <th class="is-mono">Acciones</th>
                      </tr>
                    </thead>
                    <tbody data-questions-body>
                      {questions.map((q) => (
                        <tr data-question-row data-question-id={q.id}>
                          <td
                            class="adminTable__handle"
                            draggable="true"
                            data-drag-handle
                            title="Arrastrar para reordenar"
                            aria-label="Reordenar pregunta"
                          >
                            ⠿
                          </td>
                          <td
                            class="is-mono is-tight"
                            data-question-position
                          >
                            {q.position}
                          </td>
                          <td>
                            <div class="questionCell">
                              <span class="questionCell__prompt">
                                {q.prompt}
                              </span>
                              <span class="questionCell__meta">
                                {questionMeta(q)}
                              </span>
                            </div>
                          </td>
                          <td class="is-mono is-tight">
                            {TYPE_LABELS[q.type]}
                          </td>
                          <td>
                            <span
                              class:list={[
                                "badge",
                                q.required ? "badge--warn" : "badge--off",
                              ]}
                            >
                              {q.required ? "Sí" : "No"}
                            </span>
                          </td>
                          <td>
                            <span
                              class:list={[
                                "badge",
                                q.active ? "badge--ok" : "badge--off",
                              ]}
                            >
                              {q.active ? "Activo" : "Inactivo"}
                            </span>
                          </td>
                          <td class="is-tight">
                            <span class="adminTable__actions">
                              <a
                                class="adminTable__action"
                                href={`/admin/quizzes/${quiz.id}/questions/${q.id}/edit`}
                              >
                                Editar
                              </a>
                              {q.active && (
                                <button
                                  type="button"
                                  class="adminTable__action adminTable__action--danger"
                                  data-deactivate-question={q.id}
                                  data-question-prompt={q.prompt}
                                >
                                  Desactivar
                                </button>
                              )}
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )
            }
          </div>
        </div>
      )
    }
  </section>
</AdminLayout>

<script>
  /* ── reorder via HTML5 drag-and-drop ─────────────────── */
  const tableWrap = document.querySelector<HTMLDivElement>(
    "[data-questions-table]",
  );
  const tbody = document.querySelector<HTMLTableSectionElement>(
    "[data-questions-body]",
  );
  const quizId = tableWrap?.dataset.quizId;

  if (tableWrap && tbody && quizId) {
    let draggingRow: HTMLTableRowElement | null = null;
    let snapshot: HTMLTableRowElement[] = [];

    function clearTargetMarks() {
      tbody!
        .querySelectorAll(".is-drop-target, .is-drop-target--bottom")
        .forEach((el) => {
          el.classList.remove("is-drop-target", "is-drop-target--bottom");
        });
    }

    tbody.addEventListener("dragstart", (event) => {
      const target = event.target as HTMLElement | null;
      const handle = target?.closest<HTMLElement>("[data-drag-handle]");
      if (!handle) return;
      const row = handle.closest<HTMLTableRowElement>("[data-question-row]");
      if (!row) return;
      draggingRow = row;
      snapshot = Array.from(
        tbody!.querySelectorAll<HTMLTableRowElement>("[data-question-row]"),
      );
      row.classList.add("is-dragging");
      event.dataTransfer?.setData("text/plain", row.dataset.questionId ?? "");
      if (event.dataTransfer) event.dataTransfer.effectAllowed = "move";
    });

    tbody.addEventListener("dragover", (event) => {
      if (!draggingRow) return;
      event.preventDefault();
      const target = event.target as HTMLElement | null;
      const row = target?.closest<HTMLTableRowElement>("[data-question-row]");
      if (!row || row === draggingRow) return;

      clearTargetMarks();
      const rect = row.getBoundingClientRect();
      const isBottomHalf = event.clientY > rect.top + rect.height / 2;
      row.classList.add(
        isBottomHalf ? "is-drop-target--bottom" : "is-drop-target",
      );
      if (event.dataTransfer) event.dataTransfer.dropEffect = "move";
    });

    tbody.addEventListener("dragleave", (event) => {
      const target = event.target as HTMLElement | null;
      const row = target?.closest<HTMLTableRowElement>("[data-question-row]");
      const related = event.relatedTarget as HTMLElement | null;
      if (row && (!related || !row.contains(related))) {
        row.classList.remove("is-drop-target", "is-drop-target--bottom");
      }
    });

    tbody.addEventListener("drop", async (event) => {
      if (!draggingRow) return;
      event.preventDefault();
      const target = event.target as HTMLElement | null;
      const dropRow = target?.closest<HTMLTableRowElement>(
        "[data-question-row]",
      );
      const wasDragging = draggingRow;
      clearTargetMarks();

      if (!dropRow || dropRow === draggingRow) {
        wasDragging.classList.remove("is-dragging");
        draggingRow = null;
        return;
      }

      const rect = dropRow.getBoundingClientRect();
      const isBottomHalf = event.clientY > rect.top + rect.height / 2;
      if (isBottomHalf) {
        dropRow.after(wasDragging);
      } else {
        dropRow.before(wasDragging);
      }
      wasDragging.classList.remove("is-dragging");
      draggingRow = null;

      // recompute positions 1..N for visual feedback (optimistic)
      const rows = Array.from(
        tbody!.querySelectorAll<HTMLTableRowElement>("[data-question-row]"),
      );
      const items = rows.map((row, index) => ({
        id: row.dataset.questionId ?? "",
        position: index + 1,
      }));

      rows.forEach((row, index) => {
        const positionCell = row.querySelector<HTMLElement>(
          "[data-question-position]",
        );
        if (positionCell) positionCell.textContent = String(index + 1);
      });

      try {
        const response = await fetch(
          `/api/admin/quizzes/${quizId}/questions/reorder`,
          {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ items }),
          },
        );

        if (response.status === 401) {
          window.location.href = "/admin/login";
          return;
        }
        if (response.status === 403) {
          window.location.href = "/admin/login?reason=forbidden";
          return;
        }
        if (!response.ok) {
          throw new Error(`http_${response.status}`);
        }
      } catch {
        // revert DOM and positions
        snapshot.forEach((row) => tbody!.appendChild(row));
        snapshot.forEach((row) => {
          const cell = row.querySelector<HTMLElement>(
            "[data-question-position]",
          );
          const original = row.dataset.originalPosition;
          if (cell && original) cell.textContent = original;
        });
        // restore positions from data — use the pre-drop snapshot order
        snapshot.forEach((row, index) => {
          const cell = row.querySelector<HTMLElement>(
            "[data-question-position]",
          );
          if (cell) cell.textContent = String(index + 1);
        });
        window.alert(
          "No pudimos guardar el nuevo orden. Volvimos al estado anterior.",
        );
      }
    });

    tbody.addEventListener("dragend", () => {
      if (draggingRow) {
        draggingRow.classList.remove("is-dragging");
        draggingRow = null;
      }
      clearTargetMarks();
    });
  }

  /* ── deactivate question ─────────────────────────────── */
  const deactivateButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-deactivate-question]",
  );
  const pageQuizId = tableWrap?.dataset.quizId;

  deactivateButtons.forEach((button) => {
    button.addEventListener("click", async (event) => {
      event.stopPropagation();
      const id = button.dataset.deactivateQuestion;
      const prompt = button.dataset.questionPrompt ?? "esta pregunta";
      if (!id || !pageQuizId) return;

      const confirmed = window.confirm(
        `¿Desactivar la pregunta "${prompt.length > 60 ? prompt.slice(0, 60) + "…" : prompt}"?`,
      );
      if (!confirmed) return;

      button.disabled = true;
      try {
        const response = await fetch(
          `/api/admin/quizzes/${pageQuizId}/questions/${id}`,
          {
            method: "DELETE",
            credentials: "same-origin",
          },
        );

        if (response.status === 401) {
          window.location.href = "/admin/login";
          return;
        }
        if (response.status === 403) {
          window.location.href = "/admin/login?reason=forbidden";
          return;
        }
        if (!response.ok) {
          let message = "No pudimos desactivar la pregunta.";
          try {
            const payload = await response.json();
            if (payload?.error) message = payload.error;
          } catch {
            // empty body
          }
          window.alert(message);
          button.disabled = false;
          return;
        }

        window.location.reload();
      } catch {
        window.alert("Error de red. Intentá de nuevo.");
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .quizDetail {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .quizDetail__list {
    margin: 0;
    padding: 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .quizDetail__row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-line);
    align-items: baseline;
  }

  .quizDetail__row:last-child {
    border-bottom: 0;
  }

  .quizDetail__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .quizDetail__value {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--color-ink);
  }

  .quizDetail__value.is-mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .quizDetail__value.is-muted {
    color: var(--color-ink-muted);
  }

  .questions {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .questions__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .questions__headTitles {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .questions__title {
    margin: 0;
    font-size: var(--fs-xl);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .questionCell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .questionCell__prompt {
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--color-ink);
  }

  .questionCell__meta {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  @media (max-width: 640px) {
    .quizDetail__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
