---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../admin/guard";
import { adminFetch } from "../../admin/api";
import { formatTimestamp } from "../../admin/format";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;

type AppointmentStatus = "pending" | "confirmed" | "cancelled";

interface AppAppointment {
  id: string;
  name: string;
  email: string | null;
  phone: string;
  appointment_date: string;
  status: AppointmentStatus;
  created_at: string;
}

interface AppointmentsResponse {
  appointments: AppAppointment[];
}

const result = await adminFetch<AppointmentsResponse>(
  Astro,
  "/api/admin/appointments",
);
const appointments = result.ok ? result.data.appointments : [];

const STATUS_LABEL: Record<AppointmentStatus, string> = {
  pending: "Pendiente",
  confirmed: "Confirmada",
  cancelled: "Cancelada",
};

const STATUS_BADGE: Record<AppointmentStatus, string> = {
  pending: "badge--warn",
  confirmed: "badge--ok",
  cancelled: "badge--off",
};
---

<AdminLayout title="Citas · Admin">
  <section class="adminPage">
    <header class="adminPage__head">
      <div class="adminPage__headRow">
        <div class="adminPage__headTitles">
          <span class="adminPage__eyebrow">01 / Citas</span>
          <h1 class="adminPage__title">Citas</h1>
        </div>
        <a class="btn btn--primary" href="/admin/appointments/new">
          <span>Nueva cita</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="adminPage__lead">
        Solicitudes y citas confirmadas. Haz clic en una fila para ver el
        detalle y editar; las cancelaciones se manejan cambiando el estado.
      </p>
    </header>

    {
      !result.ok ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">Error</span>
          <h2 class="adminState__title">No pudimos cargar las citas.</h2>
          <p class="adminState__lead">
            La API devolvió un error{" "}
            {result.status > 0 ? `(${result.status})` : "de red"}. Reintenta la
            carga.
          </p>
          <a class="adminState__retry" href="/admin/appointments">
            Reintentar →
          </a>
        </div>
      ) : appointments.length === 0 ? (
        <div class="adminState">
          <span class="adminState__tag">Vacío</span>
          <h2 class="adminState__title">Sin citas registradas.</h2>
          <p class="adminState__lead">
            Cuando se creen solicitudes o citas confirmadas, van a aparecer
            aquí.
          </p>
        </div>
      ) : (
        <div class="adminTable__wrap">
          <table class="adminTable">
            <thead>
              <tr>
                <th class="is-mono">Fecha cita</th>
                <th class="is-mono">Nombre</th>
                <th class="is-mono">Contacto</th>
                <th class="is-mono">Estado</th>
                <th class="is-mono">Creado</th>
              </tr>
            </thead>
            <tbody>
              {appointments.map((a) => (
                <tr
                  class="adminTable__row--clickable"
                  data-appointment-row
                  data-appointment-id={a.id}
                >
                  <td class="is-mono is-tight">
                    {formatTimestamp(a.appointment_date)}
                  </td>
                  <td>{a.name}</td>
                  <td class="is-mono is-muted">
                    {a.email ? `${a.email} · ${a.phone}` : a.phone}
                  </td>
                  <td>
                    <span class:list={["badge", STATUS_BADGE[a.status]]}>
                      {STATUS_LABEL[a.status]}
                    </span>
                  </td>
                  <td class="is-mono is-tight is-muted">
                    {formatTimestamp(a.created_at)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</AdminLayout>

<script>
  const rows = document.querySelectorAll<HTMLTableRowElement>(
    "[data-appointment-row]",
  );
  rows.forEach((row) => {
    row.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("a, button, input, select, textarea, label")) return;
      const id = row.dataset.appointmentId;
      if (id) window.location.href = `/admin/appointments/${id}`;
    });
  });
</script>

<style>
  .adminTable__row--clickable {
    cursor: pointer;
  }
</style>
