---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../../admin/guard";
import { adminFetch } from "../../../../admin/api";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/users");

interface AppUser {
  id: string;
  name: string;
  email: string;
  role: "admin" | "vendor";
  active: boolean;
  created_at: string;
}

interface UserResponse {
  user: AppUser;
}

const result = await adminFetch<UserResponse>(Astro, `/api/admin/users/${id}`);
const isNotFound = !result.ok && result.status === 404;
const user = result.ok ? result.data.user : null;
---

<AdminLayout title="Editar usuario · Admin">
  <section class="adminPage">
    <header class="adminPage__head">
      <span class="adminPage__eyebrow">01 / Usuarios · Editar</span>
      <h1 class="adminPage__title">Editar usuario</h1>
      <p class="adminPage__lead">
        El email no se puede modificar — si necesitás cambiarlo, desactivá este
        usuario y creá uno nuevo con el email correcto.
      </p>
    </header>

    {
      isNotFound ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">No encontrado</span>
          <h2 class="adminState__title">Usuario no encontrado.</h2>
          <p class="adminState__lead">
            Puede haber sido borrado o el ID es incorrecto.
          </p>
          <a class="adminState__retry" href="/admin/users">
            Volver a la lista →
          </a>
        </div>
      ) : !result.ok || !user ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">Error</span>
          <h2 class="adminState__title">No pudimos cargar el usuario.</h2>
          <p class="adminState__lead">
            La API devolvió un error
            {result.ok === false && result.status > 0
              ? ` (${result.status})`
              : " de red"}
            . Reintentá la carga.
          </p>
          <a class="adminState__retry" href={`/admin/users/${id}/edit`}>
            Reintentar →
          </a>
        </div>
      ) : (
        <form
          class="adminForm"
          novalidate
          data-form-edit-user
          data-user-id={user.id}
        >
          <div class="adminForm__alert" data-form-alert hidden>
            <span class="adminForm__alertTag" aria-hidden="true">
              ERROR
            </span>
            <span class="adminForm__alertText" data-form-alert-text />
          </div>

          <div class="adminForm__field">
            <label class="adminForm__label">
              <span class="adminForm__labelText">Email</span>
              <span class="adminForm__hint">No editable</span>
            </label>
            <span class="adminForm__readonly">{user.email}</span>
          </div>

          <div class="adminForm__field">
            <label class="adminForm__label" for="user-name">
              <span class="adminForm__labelText">Nombre</span>
              <span class="adminForm__labelReq" aria-hidden="true">
                *
              </span>
            </label>
            <input
              class="adminForm__input"
              type="text"
              name="name"
              id="user-name"
              autocomplete="name"
              required
              value={user.name}
              data-form-input="name"
            />
            <span class="adminForm__fieldError" data-form-error="name" />
          </div>

          <div class="adminForm__field">
            <label class="adminForm__label" for="user-role">
              <span class="adminForm__labelText">Rol</span>
              <span class="adminForm__labelReq" aria-hidden="true">
                *
              </span>
            </label>
            <select
              class="adminForm__select"
              name="role"
              id="user-role"
              required
              data-form-input="role"
            >
              <option value="vendor" selected={user.role === "vendor"}>
                Vendor
              </option>
              <option value="admin" selected={user.role === "admin"}>
                Admin
              </option>
            </select>
            <span class="adminForm__fieldError" data-form-error="role" />
          </div>

          <div class="adminForm__field">
            <label class="adminForm__check">
              <input
                class="adminForm__checkBox"
                type="checkbox"
                name="active"
                checked={user.active}
                data-form-input="active"
              />
              <span>Usuario activo</span>
            </label>
            <span class="adminForm__fieldError" data-form-error="active" />
          </div>

          <div class="adminForm__actions">
            <a class="adminForm__cancel" href="/admin/users">
              Cancelar
            </a>
            <button
              class="btn btn--primary adminForm__submit"
              type="submit"
              data-form-submit
            >
              <span data-form-submit-label>Guardar cambios</span>
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            </button>
          </div>
        </form>
      )
    }
  </section>
</AdminLayout>

<script>
  type Issue = { path?: (string | number)[]; message?: string };

  const form = document.querySelector<HTMLFormElement>("[data-form-edit-user]");
  if (form) {
    const userId = form.dataset.userId;
    const alertBox = form.querySelector<HTMLDivElement>("[data-form-alert]");
    const alertText = form.querySelector<HTMLSpanElement>(
      "[data-form-alert-text]",
    );
    const submit = form.querySelector<HTMLButtonElement>("[data-form-submit]");
    const submitLabel = form.querySelector<HTMLSpanElement>(
      "[data-form-submit-label]",
    );
    const fieldErrors = form.querySelectorAll<HTMLSpanElement>(
      "[data-form-error]",
    );
    const inputs = form.querySelectorAll<
      HTMLInputElement | HTMLSelectElement
    >("[data-form-input]");

    function clearErrors() {
      if (alertBox) alertBox.hidden = true;
      if (alertText) alertText.textContent = "";
      fieldErrors.forEach((el) => {
        el.textContent = "";
        el.classList.remove("is-visible");
      });
      inputs.forEach((el) => el.classList.remove("has-error"));
    }

    function showAlert(message: string) {
      if (!alertBox || !alertText) return;
      alertText.textContent = message;
      alertBox.hidden = false;
    }

    function showFieldError(field: string, message: string) {
      const errorEl = form!.querySelector<HTMLSpanElement>(
        `[data-form-error="${field}"]`,
      );
      const input = form!.querySelector<
        HTMLInputElement | HTMLSelectElement
      >(`[data-form-input="${field}"]`);
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.add("is-visible");
      }
      if (input) input.classList.add("has-error");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!userId) return;
      clearErrors();

      const data = new FormData(form);
      const payload = {
        name: String(data.get("name") ?? "").trim(),
        role: String(data.get("role") ?? ""),
        active: data.get("active") === "on",
      };

      if (!submit || !submitLabel) return;
      submit.disabled = true;
      submitLabel.textContent = "Guardando…";

      try {
        const response = await fetch(`/api/admin/users/${userId}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          window.location.href = "/admin/users";
          return;
        }

        let body: { error?: string; issues?: Issue[] } = {};
        try {
          body = await response.json();
        } catch {
          // empty body
        }

        if (response.status === 401) {
          window.location.href = "/admin/login";
          return;
        }
        if (response.status === 403) {
          window.location.href = "/admin/login?reason=forbidden";
          return;
        }
        if (response.status === 404) {
          showAlert("Este usuario ya no existe.");
        } else if (
          response.status === 400 &&
          Array.isArray(body.issues) &&
          body.issues.length > 0
        ) {
          body.issues.forEach((issue) => {
            const path = issue.path?.[0];
            if (typeof path === "string" && issue.message) {
              showFieldError(path, issue.message);
            }
          });
          showAlert("Revisá los datos del formulario.");
        } else {
          showAlert(body.error ?? "No pudimos guardar los cambios.");
        }
      } catch {
        showAlert("Error de red. Verificá tu conexión.");
      } finally {
        submit.disabled = false;
        submitLabel.textContent = "Guardar cambios";
      }
    });
  }
</script>
