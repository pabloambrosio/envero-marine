---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../../admin/guard";
import { adminFetch } from "../../../../admin/api";
import { formatTimestamp } from "../../../../admin/format";
import type { AppClient } from "../../../../modules/client/types/client";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/appointments");

type AppointmentStatus = "pending" | "confirmed" | "cancelled" | "completed";

interface AppAppointment {
  id: string;
  client_id: string;
  vendor_id: string | null;
  quiz_id: string | null;
  quiz_snapshot: unknown;
  appointment_date: string;
  status: AppointmentStatus;
  notes: string | null;
  created_at: string;
  updated_at: string;
}

interface AppUser {
  id: string;
  name: string;
  email: string;
}

interface AppointmentResponse {
  appointment: AppAppointment;
}
interface ClientResponse {
  client: AppClient;
}
interface UsersResponse {
  users: (AppUser & { role: string; active: boolean })[];
}

const [appointmentResult, usersResult] = await Promise.all([
  adminFetch<AppointmentResponse>(Astro, `/api/admin/appointments/${id}`),
  adminFetch<UsersResponse>(Astro, "/api/admin/users"),
]);

const isNotFound =
  !appointmentResult.ok && appointmentResult.status === 404;
const appointment = appointmentResult.ok
  ? appointmentResult.data.appointment
  : null;

// Segundo fetch al cliente atado a la cita. Va después del primero porque
// dependemos de `appointment.client_id` — no se puede paralelizar sin
// adivinar el id.
const clientResult = appointment
  ? await adminFetch<ClientResponse>(
      Astro,
      `/api/admin/clients/${appointment.client_id}`,
    )
  : null;
const client = clientResult?.ok ? clientResult.data.client : null;

const STATUS_LABEL: Record<AppointmentStatus, string> = {
  pending: "Pendiente",
  confirmed: "Confirmada",
  cancelled: "Cancelada",
  completed: "Completada",
};

const STATUS_BADGE: Record<AppointmentStatus, string> = {
  pending: "badge--warn",
  confirmed: "badge--ok",
  cancelled: "badge--off",
  completed: "badge--done",
};

const vendors = usersResult.ok
  ? usersResult.data.users.filter((u) => u.role === "vendor" && u.active)
  : [];

const assignedVendor = appointment?.vendor_id
  ? vendors.find((v) => v.id === appointment.vendor_id) ?? null
  : null;

const quizSnapshotPretty = appointment
  ? JSON.stringify(appointment.quiz_snapshot ?? {}, null, 2)
  : "";
---

<AdminLayout title={appointment ? `Cita · Admin` : "Cita · Admin"}>
  <section class="adminPage">
    <header class="adminPage__head">
      <div class="adminPage__headRow">
        <div class="adminPage__headTitles">
          <span class="adminPage__eyebrow">03 / Citas · Detalle</span>
          <h1 class="adminPage__title">Cita</h1>
        </div>
        {
          appointment && (
            <a
              class="btn btn--primary"
              href={`/admin/appointments/${appointment.id}/edit`}
            >
              <span>Editar cita</span>
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
      </div>
    </header>

    {
      isNotFound ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">No encontrada</span>
          <h2 class="adminState__title">Cita no encontrada.</h2>
          <p class="adminState__lead">
            Puede haber sido borrada o el ID es incorrecto.
          </p>
          <a class="adminState__retry" href="/admin/appointments">
            Volver a la lista →
          </a>
        </div>
      ) : !appointmentResult.ok || !appointment ? (
        <div class="adminState adminState--error">
          <span class="adminState__tag">Error</span>
          <h2 class="adminState__title">No pudimos cargar la cita.</h2>
          <p class="adminState__lead">
            La API devolvió un error
            {appointmentResult.ok === false && appointmentResult.status > 0
              ? ` (${appointmentResult.status})`
              : " de red"}
            . Reintentá la carga.
          </p>
          <a class="adminState__retry" href={`/admin/appointments/${id}`}>
            Reintentar →
          </a>
        </div>
      ) : (
        <div class="quizDetail">
          <dl class="quizDetail__list">
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Estado</dt>
              <dd class="quizDetail__value">
                <span class:list={["badge", STATUS_BADGE[appointment.status]]}>
                  {STATUS_LABEL[appointment.status]}
                </span>
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Fecha cita</dt>
              <dd class="quizDetail__value is-mono">
                {formatTimestamp(appointment.appointment_date)}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Vendor asignado</dt>
              <dd class:list={["quizDetail__value", { "is-muted": !assignedVendor }]}>
                {assignedVendor
                  ? `${assignedVendor.name} · ${assignedVendor.email}`
                  : "Sin asignar"}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Cliente</dt>
              <dd class="quizDetail__value">
                {client ? (
                  <div class="clientCard">
                    <span class="clientCard__name">{client.name}</span>
                    <div class="clientCard__contacts">
                      {client.email && (
                        <a
                          class="clientCard__contact"
                          href={`mailto:${client.email}`}
                        >
                          {client.email}
                        </a>
                      )}
                      {client.phone && (
                        <a
                          class="clientCard__contact"
                          href={`tel:${client.phone}`}
                        >
                          {client.phone}
                        </a>
                      )}
                      {!client.email && !client.phone && (
                        <span class="clientCard__nocontact">
                          Sin datos de contacto
                        </span>
                      )}
                    </div>
                    {client.company_name && (
                      <span class="clientCard__company">
                        {client.company_name}
                      </span>
                    )}
                  </div>
                ) : (
                  <span
                    class="is-mono is-muted"
                    title={appointment.client_id}
                  >
                    {appointment.client_id} · (no se pudo cargar el cliente)
                  </span>
                )}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Quiz vinculado</dt>
              <dd
                class:list={[
                  "quizDetail__value",
                  "is-mono",
                  { "is-muted": !appointment.quiz_id },
                ]}
                title={appointment.quiz_id ?? undefined}
              >
                {appointment.quiz_id ?? "Sin quiz vinculado"}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Notas</dt>
              <dd
                class:list={[
                  "quizDetail__value",
                  { "is-muted": !appointment.notes },
                ]}
              >
                {appointment.notes ?? "Sin notas"}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">ID</dt>
              <dd class="quizDetail__value is-mono is-muted" title={appointment.id}>
                {appointment.id}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Creada</dt>
              <dd class="quizDetail__value is-mono is-muted">
                {formatTimestamp(appointment.created_at)}
              </dd>
            </div>
            <div class="quizDetail__row">
              <dt class="quizDetail__label">Actualizada</dt>
              <dd class="quizDetail__value is-mono is-muted">
                {formatTimestamp(appointment.updated_at)}
              </dd>
            </div>
          </dl>

          <div class="snapshot">
            <header class="snapshot__head">
              <span class="adminPage__eyebrow">Quiz snapshot</span>
              <span class="snapshot__hint">
                {appointment.quiz_id
                  ? "Respuestas inmutables al momento de la solicitud"
                  : "Sin respuestas registradas"}
              </span>
            </header>
            <pre class="snapshot__body">{quizSnapshotPretty}</pre>
          </div>
        </div>
      )
    }
  </section>
</AdminLayout>

<style>
  .quizDetail {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .quizDetail__list {
    margin: 0;
    padding: 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .quizDetail__row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-line);
    align-items: baseline;
  }

  .quizDetail__row:last-child {
    border-bottom: 0;
  }

  .quizDetail__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .quizDetail__value {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--color-ink);
  }

  .quizDetail__value.is-mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .quizDetail__value.is-muted {
    color: var(--color-ink-muted);
  }

  .snapshot {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .snapshot__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .snapshot__hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .snapshot__body {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-ink);
    overflow-x: auto;
    white-space: pre;
    max-height: 420px;
    overflow-y: auto;
  }

  .clientCard {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .clientCard__name {
    font-size: var(--fs-sm);
    color: var(--color-ink);
    line-height: 1.4;
  }

  .clientCard__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .clientCard__contact {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }

  .clientCard__contact:hover,
  .clientCard__contact:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .clientCard__nocontact {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .clientCard__company {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }

  @media (max-width: 640px) {
    .quizDetail__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
