---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../admin/guard";

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.redirect;
---

<AdminLayout title="Nueva cita · Admin">
  <section class="adminPage">
    <header class="adminPage__head">
      <span class="adminPage__eyebrow">01 / Citas · Nueva</span>
      <h1 class="adminPage__title">Crear cita</h1>
      <p class="adminPage__lead">
        Cargá los datos de contacto y la fecha de la cita.
      </p>
    </header>

    <form class="adminForm" novalidate data-form-create-appointment>
      <div class="adminForm__alert" data-form-alert hidden>
        <span class="adminForm__alertTag" aria-hidden="true">ERROR</span>
        <span class="adminForm__alertText" data-form-alert-text></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="appointment-name">
          <span class="adminForm__labelText">Nombre</span>
          <span class="adminForm__labelReq" aria-hidden="true">*</span>
        </label>
        <input
          class="adminForm__input"
          type="text"
          name="name"
          id="appointment-name"
          autocomplete="name"
          required
          data-form-input="name"
        />
        <span class="adminForm__fieldError" data-form-error="name"></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="appointment-email">
          <span class="adminForm__labelText">Email</span>
          <span class="adminForm__hint">Opcional</span>
        </label>
        <input
          class="adminForm__input"
          type="email"
          name="email"
          id="appointment-email"
          autocomplete="email"
          data-form-input="email"
        />
        <span class="adminForm__fieldError" data-form-error="email"></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="appointment-phone">
          <span class="adminForm__labelText">Teléfono</span>
          <span class="adminForm__labelReq" aria-hidden="true">*</span>
        </label>
        <input
          class="adminForm__input"
          type="tel"
          name="phone"
          id="appointment-phone"
          autocomplete="tel"
          required
          data-form-input="phone"
        />
        <span class="adminForm__fieldError" data-form-error="phone"></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="appointment-company">
          <span class="adminForm__labelText">Empresa</span>
          <span class="adminForm__hint">Opcional</span>
        </label>
        <input
          class="adminForm__input"
          type="text"
          name="company_name"
          id="appointment-company"
          autocomplete="organization"
          data-form-input="company_name"
        />
        <span class="adminForm__fieldError" data-form-error="company_name"></span>
      </div>

      <div class="adminForm__section adminForm__section--divider">
        <span class="adminForm__sectionTag">Cita</span>
        <p class="adminForm__sectionLead">Fecha y estado inicial.</p>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="appointment-date">
          <span class="adminForm__labelText">Fecha cita</span>
          <span class="adminForm__labelReq" aria-hidden="true">*</span>
        </label>
        <input
          class="adminForm__input"
          type="datetime-local"
          name="appointment_date"
          id="appointment-date"
          required
          data-form-input="appointment_date"
        />
        <span
          class="adminForm__fieldError"
          data-form-error="appointment_date"
        ></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="appointment-status">
          <span class="adminForm__labelText">Estado inicial</span>
        </label>
        <select
          class="adminForm__select"
          name="status"
          id="appointment-status"
          data-form-input="status"
        >
          <option value="pending" selected>Pendiente</option>
          <option value="confirmed">Confirmada</option>
          <option value="cancelled">Cancelada</option>
        </select>
        <span class="adminForm__fieldError" data-form-error="status"></span>
      </div>

      <div class="adminForm__field">
        <label class="adminForm__label" for="appointment-notes">
          <span class="adminForm__labelText">Notas</span>
          <span class="adminForm__hint">Opcional</span>
        </label>
        <textarea
          class="adminForm__input adminForm__input--textarea"
          name="notes"
          id="appointment-notes"
          rows="3"
          data-form-input="notes"></textarea>
        <span class="adminForm__fieldError" data-form-error="notes"></span>
      </div>

      <div class="adminForm__actions">
        <a class="adminForm__cancel" href="/admin/appointments">Cancelar</a>
        <button
          class="btn btn--primary adminForm__submit"
          type="submit"
          data-form-submit
        >
          <span data-form-submit-label>Crear cita</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </section>
</AdminLayout>

<script>
  type Issue = { path?: (string | number)[]; message?: string };

  const form = document.querySelector<HTMLFormElement>(
    "[data-form-create-appointment]",
  );

  if (form) {
    const alertBox = form.querySelector<HTMLDivElement>("[data-form-alert]");
    const alertText = form.querySelector<HTMLSpanElement>(
      "[data-form-alert-text]",
    );
    const submit = form.querySelector<HTMLButtonElement>("[data-form-submit]");
    const submitLabel = form.querySelector<HTMLSpanElement>(
      "[data-form-submit-label]",
    );
    const fieldErrors = form.querySelectorAll<HTMLSpanElement>(
      "[data-form-error]",
    );
    const inputs = form.querySelectorAll<
      HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
    >("[data-form-input]");

    function clearErrors() {
      if (alertBox) alertBox.hidden = true;
      if (alertText) alertText.textContent = "";
      fieldErrors.forEach((el) => {
        el.textContent = "";
        el.classList.remove("is-visible");
      });
      inputs.forEach((el) => el.classList.remove("has-error"));
    }

    function showAlert(message: string) {
      if (!alertBox || !alertText) return;
      alertText.textContent = message;
      alertBox.hidden = false;
    }

    function showFieldError(field: string, message: string) {
      const errorEl = form!.querySelector<HTMLSpanElement>(
        `[data-form-error="${field}"]`,
      );
      const input = form!.querySelector<
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >(`[data-form-input="${field}"]`);
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.add("is-visible");
      }
      if (input) input.classList.add("has-error");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearErrors();

      const data = new FormData(form);
      const notesRaw = String(data.get("notes") ?? "").trim();
      const companyNameRaw = String(data.get("company_name") ?? "").trim();
      const emailRaw = String(data.get("email") ?? "").trim();

      const payload: Record<string, unknown> = {
        name: String(data.get("name") ?? "").trim(),
        phone: String(data.get("phone") ?? "").trim(),
        appointment_date: String(data.get("appointment_date") ?? "").trim(),
        status: String(data.get("status") ?? "pending"),
      };
      if (emailRaw) payload.email = emailRaw;
      if (companyNameRaw) payload.company_name = companyNameRaw;
      if (notesRaw) payload.notes = notesRaw;

      if (!submit || !submitLabel) return;
      submit.disabled = true;
      submitLabel.textContent = "Creando cita…";

      try {
        const response = await fetch("/api/admin/appointments", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });

        if (response.status === 401) {
          window.location.href = "/admin/login";
          return;
        }
        if (response.status === 403) {
          window.location.href = "/admin/login?reason=forbidden";
          return;
        }

        const body = await response.json().catch(() => ({}));

        if (!response.ok) {
          if (
            response.status === 400 &&
            Array.isArray(body.issues) &&
            body.issues.length > 0
          ) {
            body.issues.forEach((issue: Issue) => {
              const path = issue.path?.[0];
              if (typeof path === "string" && issue.message) {
                showFieldError(path, issue.message);
              }
            });
            showAlert("Revisá los datos del formulario.");
          } else {
            showAlert(body.error ?? "No pudimos crear la cita.");
          }
          submit.disabled = false;
          submitLabel.textContent = "Crear cita";
          return;
        }

        const appointmentId = body.appointment?.id;
        window.location.href = appointmentId
          ? `/admin/appointments/${appointmentId}`
          : "/admin/appointments";
      } catch {
        showAlert("Error de red al crear la cita.");
        submit.disabled = false;
        submitLabel.textContent = "Crear cita";
      }
    });
  }
</script>

<style>
  .adminForm__input--textarea {
    min-height: 88px;
    resize: vertical;
    padding-top: 0.6rem;
    border-bottom-color: var(--color-line);
    border: 1px solid var(--color-line);
    padding: 0.6rem;
  }

  .adminForm__input--textarea:hover {
    border-color: var(--color-primary-soft);
  }

  .adminForm__input--textarea:focus,
  .adminForm__input--textarea:focus-visible {
    border-color: var(--color-accent);
    border-bottom-width: 2px;
  }

  .adminForm__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .adminForm__section--divider {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .adminForm__sectionTag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .adminForm__sectionLead {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
</style>
