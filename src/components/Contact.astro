---
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const emailValue = t("contact.channels.email.value");
const whatsappValue = t("contact.channels.whatsapp.value");
const whatsappHref = `https://wa.me/${whatsappValue.replace(/[^\d]/g, "")}`;
---

<section class="contact" id="contacto" aria-label={t("contact.aria")}>
  <div class="contact__container">
    <header class="contact__head">
      <span class="contact__eyebrow">{t("contact.eyebrow")}</span>
    </header>

    <div class="contact__bento">
      <aside class="contact__info">
        <span class="contact__tag" aria-hidden="true">{t("contact.info.tag")}</span>
        <h2 class="contact__heading">{t("contact.heading")}</h2>
        <p class="contact__lead">{t("contact.lead")}</p>

        <ul class="contact__channels" aria-label={t("contact.channels.aria")}>
          <li class="contact__channel">
            <span class="contact__channelLabel">{t("contact.channels.email.label")}</span>
            <a class="contact__channelValue" href={`mailto:${emailValue}`}>{emailValue}</a>
          </li>
          <li class="contact__channel">
            <span class="contact__channelLabel">{t("contact.channels.whatsapp.label")}</span>
            <a
              class="contact__channelValue"
              href={whatsappHref}
              target="_blank"
              rel="noopener"
            >
              {whatsappValue}
            </a>
          </li>
          <li class="contact__channel">
            <span class="contact__channelLabel">{t("contact.channels.base.label")}</span>
            <span class="contact__channelValue">{t("contact.channels.base.value")}</span>
          </li>
        </ul>

        <span class="contact__sig" aria-hidden="true">{t("contact.info.signature")}</span>
      </aside>

      <form
        class="contact__form"
        action={`mailto:${emailValue}`}
        method="post"
        enctype="text/plain"
        aria-label={t("contact.form.aria")}
      >
        <div class="contact__formHead">
          <span class="contact__formTag" aria-hidden="true">{t("contact.form.tag")}</span>
          <span class="contact__formCount" aria-hidden="true">05 / 05</span>
        </div>

        <div class="contact__fields">
          <div class="contact__field contact__field--half">
            <label class="contact__label" for="contact-name">
              <span class="contact__labelNum" aria-hidden="true">01</span>
              <span class="contact__labelText">{t("contact.form.field.name")}</span>
              <span class="contact__labelReq" aria-hidden="true">*</span>
            </label>
            <input
              class="contact__input"
              type="text"
              name="name"
              id="contact-name"
              autocomplete="name"
              required
            />
          </div>

          <div class="contact__field contact__field--half">
            <label class="contact__label" for="contact-email">
              <span class="contact__labelNum" aria-hidden="true">02</span>
              <span class="contact__labelText">{t("contact.form.field.email")}</span>
              <span class="contact__labelReq" aria-hidden="true">*</span>
            </label>
            <input
              class="contact__input"
              type="email"
              name="email"
              id="contact-email"
              autocomplete="email"
              required
            />
          </div>

          <div class="contact__field contact__field--half">
            <label class="contact__label" for="contact-company">
              <span class="contact__labelNum" aria-hidden="true">03</span>
              <span class="contact__labelText">{t("contact.form.field.company")}</span>
            </label>
            <input
              class="contact__input"
              type="text"
              name="company"
              id="contact-company"
              autocomplete="organization"
            />
          </div>

          <div class="contact__field contact__field--half">
            <label class="contact__label" for="contact-phone">
              <span class="contact__labelNum" aria-hidden="true">04</span>
              <span class="contact__labelText">{t("contact.form.field.phone")}</span>
            </label>
            <input
              class="contact__input"
              type="tel"
              name="phone"
              id="contact-phone"
              autocomplete="tel"
            />
          </div>

          <div class="contact__field contact__field--full">
            <label class="contact__label" for="contact-message">
              <span class="contact__labelNum" aria-hidden="true">05</span>
              <span class="contact__labelText">{t("contact.form.field.message")}</span>
              <span class="contact__labelReq" aria-hidden="true">*</span>
            </label>
            <textarea
              class="contact__input contact__input--textarea"
              name="message"
              id="contact-message"
              rows="4"
              required
            ></textarea>
          </div>
        </div>

        <div class="contact__formFoot">
          <span class="contact__formNote">{t("contact.form.note")}</span>
          <button class="btn btn--primary contact__submit" type="submit">
            <span>{t("contact.form.cta")}</span>
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .contact__container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .contact__head {
    margin-bottom: var(--space-5);
  }

  .contact__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* ── bento layout ─────────────────────────────────────── */
  .contact__bento {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  /* ── info panel (green) ───────────────────────────────── */
  .contact__info {
    position: relative;
    background-color: var(--color-primary);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0,
      transparent 14px,
      rgba(245, 242, 236, 0.05) 14px,
      rgba(245, 242, 236, 0.05) 15px
    );
    color: var(--color-bg);
    padding: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    overflow: hidden;
  }

  .contact__info::after {
    content: "";
    position: absolute;
    inset: var(--space-3);
    border: 1px dashed rgba(245, 242, 236, 0.18);
    pointer-events: none;
  }

  .contact__info > * {
    position: relative;
    z-index: 1;
  }

  .contact__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }

  .contact__heading {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-bg);
    max-width: 18ch;
  }

  .contact__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: rgba(245, 242, 236, 0.78);
    max-width: 38ch;
  }

  .contact__channels {
    margin: auto 0 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid rgba(245, 242, 236, 0.18);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__channel {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact__channelLabel {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.55);
  }

  .contact__channelValue {
    font-size: var(--fs-md);
    line-height: 1.4;
    color: var(--color-bg);
    transition: color 200ms var(--ease-out);
    word-break: break-word;
  }

  a.contact__channelValue {
    border-bottom: 1px solid rgba(245, 242, 236, 0.22);
    padding-bottom: 2px;
    align-self: flex-start;
  }

  a.contact__channelValue:hover {
    color: var(--color-accent-soft);
    border-bottom-color: var(--color-accent-soft);
  }

  .contact__sig {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.4);
  }

  /* ── form panel (white) ───────────────────────────────── */
  .contact__form {
    position: relative;
    background: var(--color-surface);
    padding: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* registration marks */
  .contact__form::before,
  .contact__form::after {
    content: "+";
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1;
    color: var(--color-line);
    pointer-events: none;
  }

  .contact__form::before {
    top: 8px;
    left: 8px;
  }

  .contact__form::after {
    bottom: 8px;
    right: 8px;
  }

  .contact__formHead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .contact__formCount {
    opacity: 0.7;
  }

  .contact__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .contact__field--full {
    grid-column: 1 / -1;
  }

  .contact__label {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact__labelNum {
    color: var(--color-primary);
    opacity: 0.55;
  }

  .contact__labelText {
    color: var(--color-ink);
  }

  .contact__labelReq {
    color: var(--color-accent);
  }

  .contact__input {
    width: 100%;
    padding: 0.6rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    line-height: 1.4;
    color: var(--color-ink);
    transition: border-color 200ms var(--ease-out);
    outline: none;
    border-radius: 0;
  }

  .contact__input:hover {
    border-bottom-color: var(--color-primary-soft);
  }

  .contact__input:focus,
  .contact__input:focus-visible {
    border-bottom-color: var(--color-accent);
    border-bottom-width: 2px;
    padding-bottom: calc(0.6rem - 1px);
  }

  .contact__input--textarea {
    min-height: 120px;
    resize: vertical;
    padding-top: 0.6rem;
  }

  .contact__formFoot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
    flex-wrap: wrap;
  }

  .contact__formNote {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .contact__submit {
    flex: 0 0 auto;
  }

  /* ── tablet ───────────────────────────────────────────── */
  @media (max-width: 960px) {
    .contact {
      padding: var(--space-7) 0;
    }

    .contact__bento {
      grid-template-columns: 1fr;
    }

    .contact__info {
      padding: var(--space-6) var(--space-5);
    }

    .contact__form {
      padding: var(--space-6) var(--space-5);
    }

    .contact__heading {
      font-size: var(--fs-xl);
    }
  }

  /* ── mobile ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .contact {
      padding: var(--space-6) 0;
    }

    .contact__info,
    .contact__form {
      padding: var(--space-5) var(--space-4);
    }

    .contact__fields {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .contact__heading {
      font-size: var(--fs-lg);
    }

    .contact__lead {
      font-size: var(--fs-sm);
    }

    .contact__formFoot {
      flex-direction: column;
      align-items: stretch;
    }

    .contact__submit {
      justify-content: space-between;
    }
  }
</style>
