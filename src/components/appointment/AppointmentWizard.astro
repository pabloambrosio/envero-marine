---
// Wizard de agendamiento público anónimo. Va adentro de <Modal/> agnóstico.
// Si mañana hace falta otro form en el modal, este componente se intercambia
// y Modal queda igual.
//
// Tres steps + estado terminal de éxito:
//   01. Agendá   — calendario + selección de slot horario
//   02. Tus datos — nombre + email/teléfono + empresa
//   03. Confirmá  — resumen + notas opcionales + submit
//
// Las reglas de slot (lun-vie, 08-17 hora en punto, TZ Mérida) se aplican
// en el calendario y se reconfirman en el backend (Zod + CHECK + RLS).

import { resolveLang, useTranslations } from "../../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const i18n = {
  errorContactRequired: t("wizard.contact.error.contactRequired"),
  errorEmailInvalid: t("wizard.contact.error.emailInvalid"),
  errorNameRequired: t("wizard.contact.error.nameRequired"),
  alertNetwork: t("wizard.alert.network"),
  alertServerGeneric: t("wizard.alert.serverGeneric"),
  successLead: t("wizard.success.lead"),
  submitLabel: t("wizard.button.submit"),
  submittingLabel: t("wizard.button.submitting"),
  nextLabel: t("wizard.button.next"),
  slotsForDay: t("wizard.schedule.slotsForDay"),
  calNoSlot: t("wizard.schedule.noSlot"),
  weekdayShort: [
    t("wizard.schedule.weekday.mon"),
    t("wizard.schedule.weekday.tue"),
    t("wizard.schedule.weekday.wed"),
    t("wizard.schedule.weekday.thu"),
    t("wizard.schedule.weekday.fri"),
    t("wizard.schedule.weekday.sat"),
    t("wizard.schedule.weekday.sun"),
  ],
  intlLocale: lang === "en" ? "en-US" : "es-MX",
};
---

<div class="wizard" data-wizard>
  <header class="wizard__head">
    <ol class="wizard__steps" aria-label={t("wizard.steps.aria")}>
      <li class="wizard__step is-active" data-stepper-item="schedule">
        <span class="wizard__stepNum">01</span>
        <span class="wizard__stepLabel">{t("wizard.steps.schedule")}</span>
      </li>
      <li class="wizard__step" data-stepper-item="contact">
        <span class="wizard__stepNum">02</span>
        <span class="wizard__stepLabel">{t("wizard.steps.contact")}</span>
      </li>
      <li class="wizard__step" data-stepper-item="confirm">
        <span class="wizard__stepNum">03</span>
        <span class="wizard__stepLabel">{t("wizard.steps.confirm")}</span>
      </li>
    </ol>
  </header>

  <div class="wizard__body">
    {/* ── 01 · Schedule ─────────────────────────────────────────────── */}
    <section
      class="wizard__pane is-active"
      data-wizard-pane="schedule"
    >
      <p class="wizard__intro">{t("wizard.schedule.intro")}</p>

      <div class="aptCal">
        <header class="aptCal__head">
          <button
            type="button"
            class="aptCal__nav"
            data-cal-prev
            aria-label={t("wizard.schedule.calMonthPrev")}
          >←</button>
          <span class="aptCal__month" data-cal-month></span>
          <button
            type="button"
            class="aptCal__nav"
            data-cal-next
            aria-label={t("wizard.schedule.calMonthNext")}
          >→</button>
        </header>
        <div class="aptCal__weekdays" aria-hidden="true" data-cal-weekdays></div>
        <div
          class="aptCal__grid"
          role="grid"
          data-cal-grid
          aria-label={t("wizard.schedule.calGridAria")}
        ></div>
      </div>

      <div class="aptSlots" data-slots hidden>
        <p class="aptSlots__hint">
          <span class="aptSlots__hintLabel">{t("wizard.schedule.slotsForDay")}</span>
          <strong class="aptSlots__hintDay" data-slots-day></strong>
        </p>
        <div
          class="aptSlots__grid"
          role="radiogroup"
          aria-label={t("wizard.schedule.slotsAria")}
          data-slots-grid
        ></div>
      </div>

      <p class="aptSlots__empty" data-slots-empty hidden>
        {t("wizard.schedule.pickDay")}
      </p>
    </section>

    {/* ── 02 · Contact ──────────────────────────────────────────────── */}
    <section
      class="wizard__pane"
      data-wizard-pane="contact"
      hidden
    >
      <p class="wizard__intro">{t("wizard.contact.intro")}</p>

      <div class="wizardField">
        <label class="wizardField__label" for="apt-name">
          <span>{t("wizard.contact.field.name")}</span>
          <span class="wizardField__req" aria-hidden="true">*</span>
        </label>
        <input
          class="wizardField__input"
          id="apt-name"
          type="text"
          required
          autocomplete="name"
          data-input-name
        />
        <span class="wizardField__error" data-error="name"></span>
      </div>

      <div class="wizardField">
        <label class="wizardField__label" for="apt-email">
          <span>{t("wizard.contact.field.email")}</span>
        </label>
        <input
          class="wizardField__input"
          id="apt-email"
          type="email"
          autocomplete="email"
          data-input-email
        />
        <span class="wizardField__error" data-error="email"></span>
      </div>

      <div class="wizardField">
        <label class="wizardField__label" for="apt-phone">
          <span>{t("wizard.contact.field.phone")}</span>
        </label>
        <input
          class="wizardField__input"
          id="apt-phone"
          type="tel"
          autocomplete="tel"
          data-input-phone
        />
        <span class="wizardField__error" data-error="phone"></span>
      </div>

      <div class="wizardField">
        <label class="wizardField__label" for="apt-company">
          <span>{t("wizard.contact.field.company")}</span>
          <span class="wizardField__hint">
            {t("wizard.contact.field.optional")}
          </span>
        </label>
        <input
          class="wizardField__input"
          id="apt-company"
          type="text"
          autocomplete="organization"
          data-input-company
        />
      </div>
    </section>

    {/* ── 03 · Confirm ──────────────────────────────────────────────── */}
    <section
      class="wizard__pane"
      data-wizard-pane="confirm"
      hidden
    >
      <p class="wizard__intro">{t("wizard.confirm.intro")}</p>

      <dl class="wizardSummary">
        <div class="wizardSummary__row">
          <dt class="wizardSummary__label">{t("wizard.confirm.summary.date")}</dt>
          <dd class="wizardSummary__value" data-summary-date>—</dd>
        </div>
        <div class="wizardSummary__row">
          <dt class="wizardSummary__label">{t("wizard.confirm.summary.time")}</dt>
          <dd class="wizardSummary__value" data-summary-time>—</dd>
        </div>
        <div class="wizardSummary__row">
          <dt class="wizardSummary__label">{t("wizard.confirm.summary.name")}</dt>
          <dd class="wizardSummary__value" data-summary-name>—</dd>
        </div>
        <div class="wizardSummary__row">
          <dt class="wizardSummary__label">{t("wizard.confirm.summary.contact")}</dt>
          <dd class="wizardSummary__value" data-summary-contact>—</dd>
        </div>
        <div
          class="wizardSummary__row"
          data-summary-company-row
          hidden
        >
          <dt class="wizardSummary__label">{t("wizard.confirm.summary.company")}</dt>
          <dd class="wizardSummary__value" data-summary-company>—</dd>
        </div>
      </dl>

      <div class="wizardField">
        <label class="wizardField__label" for="apt-notes">
          <span>{t("wizard.confirm.field.notes")}</span>
          <span class="wizardField__hint">
            {t("wizard.contact.field.optional")}
          </span>
        </label>
        <textarea
          class="wizardField__input wizardField__input--textarea"
          id="apt-notes"
          rows="3"
          data-input-notes
        ></textarea>
      </div>

      <div class="wizardAlert" data-wizard-alert hidden>
        <span class="wizardAlert__tag">{t("wizard.alert.tag")}</span>
        <span class="wizardAlert__text" data-alert-text></span>
      </div>
    </section>

    {/* ── Success terminal ──────────────────────────────────────────── */}
    <section
      class="wizard__pane wizard__pane--success"
      data-wizard-pane="success"
      hidden
    >
      <span class="wizardSuccess__tag">{t("wizard.success.tag")}</span>
      <h3 class="wizardSuccess__title">{t("wizard.success.title")}</h3>
      <p class="wizardSuccess__lead" data-success-text></p>
      <button
        type="button"
        class="btn btn--ghost"
        data-modal-close
      >
        <span>{t("wizard.button.close")}</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>
    </section>
  </div>

  <footer class="wizard__foot" data-wizard-foot>
    <button
      type="button"
      class="wizard__back"
      data-wizard-back
      hidden
    >
      <span aria-hidden="true">←</span>
      <span>{t("wizard.button.back")}</span>
    </button>
    <button
      type="button"
      class="btn btn--primary wizard__next"
      data-wizard-next
      disabled
    >
      <span data-next-label>{t("wizard.button.next")}</span>
      <span class="btn__arrow" aria-hidden="true">→</span>
    </button>
  </footer>
</div>

<script is:inline define:vars={{ i18n }}>
  // Wizard controller. Inline porque usa define:vars para inyectar las labels
  // localizadas. Sin librerías — DOM + state local.
  //
  // State shape:
  //   step: 'schedule' | 'contact' | 'confirm' | 'success'
  //   viewYear / viewMonth: mes que muestra el calendario (mes actual al abrir)
  //   selectedDate: Date | null  (día elegido, hora 00:00 local)
  //   selectedSlot: number | null  (8..17, hora en punto en TZ Mérida)
  //   contact: { name, email, phone, company }
  //   notes: string

  const root = document.querySelector("[data-wizard]");
  if (root) {
    const STEPS = ["schedule", "contact", "confirm"];
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const state = {
      step: "schedule",
      viewYear: today.getFullYear(),
      viewMonth: today.getMonth(),
      selectedDate: null,
      selectedSlot: null,
      contact: { name: "", email: "", phone: "", company: "" },
      notes: "",
      submitting: false,
    };

    // ── DOM refs ────────────────────────────────────────────────────
    const stepperItems = root.querySelectorAll("[data-stepper-item]");
    const panes = root.querySelectorAll("[data-wizard-pane]");
    const backBtn = root.querySelector("[data-wizard-back]");
    const nextBtn = root.querySelector("[data-wizard-next]");
    const nextLabel = root.querySelector("[data-next-label]");
    const calMonthEl = root.querySelector("[data-cal-month]");
    const calWeekdaysEl = root.querySelector("[data-cal-weekdays]");
    const calGridEl = root.querySelector("[data-cal-grid]");
    const calPrevBtn = root.querySelector("[data-cal-prev]");
    const calNextBtn = root.querySelector("[data-cal-next]");
    const slotsEl = root.querySelector("[data-slots]");
    const slotsDayEl = root.querySelector("[data-slots-day]");
    const slotsGridEl = root.querySelector("[data-slots-grid]");
    const slotsEmptyEl = root.querySelector("[data-slots-empty]");
    const inputs = {
      name: root.querySelector("[data-input-name]"),
      email: root.querySelector("[data-input-email]"),
      phone: root.querySelector("[data-input-phone]"),
      company: root.querySelector("[data-input-company]"),
      notes: root.querySelector("[data-input-notes]"),
    };
    const errors = {
      name: root.querySelector('[data-error="name"]'),
      email: root.querySelector('[data-error="email"]'),
      phone: root.querySelector('[data-error="phone"]'),
    };
    const summary = {
      date: root.querySelector("[data-summary-date]"),
      time: root.querySelector("[data-summary-time]"),
      name: root.querySelector("[data-summary-name]"),
      contact: root.querySelector("[data-summary-contact]"),
      company: root.querySelector("[data-summary-company]"),
      companyRow: root.querySelector("[data-summary-company-row]"),
    };
    const alertEl = root.querySelector("[data-wizard-alert]");
    const alertText = root.querySelector("[data-alert-text]");
    const successText = root.querySelector("[data-success-text]");

    // ── Calendar ────────────────────────────────────────────────────
    function renderWeekdays() {
      // Lun a Dom (índices 0..6 alineados a state.weekdayShort)
      calWeekdaysEl.innerHTML = "";
      i18n.weekdayShort.forEach((label) => {
        const cell = document.createElement("span");
        cell.className = "aptCal__weekday";
        cell.textContent = label;
        calWeekdaysEl.appendChild(cell);
      });
    }

    function sameDay(a, b) {
      return (
        a.getFullYear() === b.getFullYear() &&
        a.getMonth() === b.getMonth() &&
        a.getDate() === b.getDate()
      );
    }

    function isSelectable(date) {
      if (date < today) return false;
      const dow = date.getDay(); // 0=dom, 6=sáb
      if (dow === 0 || dow === 6) return false;
      return true;
    }

    function formatMonthYear(year, month) {
      const fmt = new Intl.DateTimeFormat(i18n.intlLocale, {
        month: "long",
        year: "numeric",
      });
      const date = new Date(year, month, 1);
      const text = fmt.format(date);
      return text.charAt(0).toUpperCase() + text.slice(1);
    }

    function formatLongDate(date) {
      const fmt = new Intl.DateTimeFormat(i18n.intlLocale, {
        weekday: "long",
        day: "numeric",
        month: "long",
      });
      const text = fmt.format(date);
      return text.charAt(0).toUpperCase() + text.slice(1);
    }

    function renderCalendar() {
      const year = state.viewYear;
      const month = state.viewMonth;

      calMonthEl.textContent = formatMonthYear(year, month);

      // Bloquear "anterior" si viewMonth === mes actual
      const isCurrentMonthView =
        year === today.getFullYear() && month === today.getMonth();
      calPrevBtn.disabled = isCurrentMonthView;

      // Construir grilla 6 * 7. Empezamos en lunes.
      const firstOfMonth = new Date(year, month, 1);
      // getDay: 0=dom..6=sáb. Convertir a "lunes=0..domingo=6".
      const startWeekdayMonFirst = (firstOfMonth.getDay() + 6) % 7;
      const gridStart = new Date(year, month, 1 - startWeekdayMonFirst);

      calGridEl.innerHTML = "";

      for (let i = 0; i < 42; i++) {
        const cellDate = new Date(gridStart);
        cellDate.setDate(gridStart.getDate() + i);
        cellDate.setHours(0, 0, 0, 0);

        const inMonth = cellDate.getMonth() === month;
        const selectable = inMonth && isSelectable(cellDate);
        const selected =
          state.selectedDate && sameDay(cellDate, state.selectedDate);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "aptCal__cell";
        btn.dataset.iso = cellDate.toISOString();
        btn.textContent = String(cellDate.getDate());
        if (!inMonth) btn.classList.add("is-out");
        if (!selectable) {
          btn.classList.add("is-disabled");
          btn.disabled = true;
        }
        if (selected) btn.classList.add("is-selected");
        if (selectable) {
          btn.addEventListener("click", () => handleDayClick(cellDate));
        }
        calGridEl.appendChild(btn);
      }
    }

    function handleDayClick(date) {
      state.selectedDate = new Date(date);
      state.selectedSlot = null;
      renderCalendar();
      renderSlots();
      updateNavState();
    }

    // ── Slots ───────────────────────────────────────────────────────
    function renderSlots() {
      if (!state.selectedDate) {
        slotsEl.hidden = true;
        slotsEmptyEl.hidden = false;
        return;
      }
      slotsEmptyEl.hidden = true;
      slotsEl.hidden = false;
      slotsDayEl.textContent = formatLongDate(state.selectedDate);

      slotsGridEl.innerHTML = "";
      for (let h = 8; h <= 17; h++) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "aptSlot";
        btn.role = "radio";
        btn.dataset.hour = String(h);
        btn.textContent = `${String(h).padStart(2, "0")}:00`;
        if (state.selectedSlot === h) {
          btn.classList.add("is-selected");
          btn.setAttribute("aria-checked", "true");
        } else {
          btn.setAttribute("aria-checked", "false");
        }
        btn.addEventListener("click", () => {
          state.selectedSlot = h;
          renderSlots();
          updateNavState();
        });
        slotsGridEl.appendChild(btn);
      }
    }

    // ── Step navigation ─────────────────────────────────────────────
    function goToStep(step) {
      state.step = step;
      panes.forEach((pane) => {
        const isActive = pane.dataset.wizardPane === step;
        pane.hidden = !isActive;
        pane.classList.toggle("is-active", isActive);
      });
      stepperItems.forEach((item) => {
        const itemStep = item.dataset.stepperItem;
        const stepIdx = STEPS.indexOf(step);
        const itemIdx = STEPS.indexOf(itemStep);
        item.classList.toggle("is-active", itemStep === step);
        item.classList.toggle("is-done", stepIdx > itemIdx && stepIdx < STEPS.length);
      });

      // Footer visibility: succeed terminal hides the footer.
      const foot = root.querySelector("[data-wizard-foot]");
      foot.hidden = step === "success";
      backBtn.hidden = step === "schedule" || step === "success";

      if (step === "confirm") {
        nextLabel.textContent = i18n.submitLabel;
      } else {
        nextLabel.textContent = i18n.nextLabel;
      }

      if (step === "confirm") populateSummary();
      updateNavState();
    }

    function updateNavState() {
      let canAdvance = false;
      if (state.step === "schedule") {
        canAdvance =
          state.selectedDate !== null && state.selectedSlot !== null;
      } else if (state.step === "contact") {
        canAdvance = isContactValid().ok;
      } else if (state.step === "confirm") {
        canAdvance = !state.submitting;
      }
      nextBtn.disabled = !canAdvance;
    }

    // ── Contact validation ──────────────────────────────────────────
    function isContactValid() {
      const c = state.contact;
      if (!c.name.trim()) {
        return { ok: false, field: "name", message: i18n.errorNameRequired };
      }
      if (!c.email.trim() && !c.phone.trim()) {
        return {
          ok: false,
          field: "email",
          message: i18n.errorContactRequired,
        };
      }
      if (c.email.trim()) {
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!re.test(c.email.trim())) {
          return {
            ok: false,
            field: "email",
            message: i18n.errorEmailInvalid,
          };
        }
      }
      return { ok: true };
    }

    function clearContactErrors() {
      Object.values(errors).forEach((el) => {
        el.textContent = "";
        el.classList.remove("is-visible");
      });
      Object.values(inputs).forEach((el) => {
        if (el) el.classList.remove("has-error");
      });
    }

    function showFieldError(field, message) {
      const el = errors[field];
      if (el) {
        el.textContent = message;
        el.classList.add("is-visible");
      }
      const input = inputs[field];
      if (input) input.classList.add("has-error");
    }

    // ── Summary + submit ────────────────────────────────────────────
    function populateSummary() {
      if (state.selectedDate) {
        summary.date.textContent = formatLongDate(state.selectedDate);
      }
      if (state.selectedSlot !== null) {
        summary.time.textContent = `${String(state.selectedSlot).padStart(2, "0")}:00 (GMT-6)`;
      }
      summary.name.textContent = state.contact.name;
      const contactBits = [];
      if (state.contact.email) contactBits.push(state.contact.email);
      if (state.contact.phone) contactBits.push(state.contact.phone);
      summary.contact.textContent = contactBits.join(" · ");
      if (state.contact.company) {
        summary.company.textContent = state.contact.company;
        summary.companyRow.hidden = false;
      } else {
        summary.companyRow.hidden = true;
      }
    }

    function buildIsoSlot() {
      const d = state.selectedDate;
      const h = state.selectedSlot;
      const yyyy = d.getFullYear();
      const mm = String(d.getMonth() + 1).padStart(2, "0");
      const dd = String(d.getDate()).padStart(2, "0");
      const hh = String(h).padStart(2, "0");
      // TZ Mérida fija en -06:00 (sin DST). Ver appointment/lib/slot.ts.
      return `${yyyy}-${mm}-${dd}T${hh}:00:00-06:00`;
    }

    function clearAlert() {
      alertEl.hidden = true;
      alertText.textContent = "";
    }

    function showAlert(message) {
      alertText.textContent = message;
      alertEl.hidden = false;
    }

    async function submit() {
      clearAlert();
      state.submitting = true;
      updateNavState();
      nextLabel.textContent = i18n.submittingLabel;

      const payload = {
        client: {
          name: state.contact.name.trim(),
        },
        appointment_date: buildIsoSlot(),
      };
      if (state.contact.email.trim()) payload.client.email = state.contact.email.trim();
      if (state.contact.phone.trim()) payload.client.phone = state.contact.phone.trim();
      if (state.contact.company.trim()) payload.client.company_name = state.contact.company.trim();
      if (state.notes.trim()) payload.notes = state.notes.trim();

      try {
        const res = await fetch("/api/appointments", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const body = await res.json().catch(() => ({}));

        if (!res.ok) {
          showAlert(body.error || i18n.alertServerGeneric);
          state.submitting = false;
          nextLabel.textContent = i18n.submitLabel;
          updateNavState();
          return;
        }

        const via = state.contact.email || state.contact.phone || "—";
        const when = `${formatLongDate(state.selectedDate)} · ${String(state.selectedSlot).padStart(2, "0")}:00`;
        successText.textContent = i18n.successLead
          .replace("{via}", via)
          .replace("{when}", when);

        goToStep("success");
        state.submitting = false;
      } catch {
        showAlert(i18n.alertNetwork);
        state.submitting = false;
        nextLabel.textContent = i18n.submitLabel;
        updateNavState();
      }
    }

    // ── Event wiring ────────────────────────────────────────────────
    calPrevBtn.addEventListener("click", () => {
      if (calPrevBtn.disabled) return;
      let m = state.viewMonth - 1;
      let y = state.viewYear;
      if (m < 0) {
        m = 11;
        y -= 1;
      }
      state.viewMonth = m;
      state.viewYear = y;
      renderCalendar();
    });

    calNextBtn.addEventListener("click", () => {
      let m = state.viewMonth + 1;
      let y = state.viewYear;
      if (m > 11) {
        m = 0;
        y += 1;
      }
      state.viewMonth = m;
      state.viewYear = y;
      renderCalendar();
    });

    ["name", "email", "phone", "company"].forEach((key) => {
      const el = inputs[key];
      if (!el) return;
      el.addEventListener("input", () => {
        state.contact[key] = el.value;
        clearContactErrors();
        updateNavState();
      });
    });

    if (inputs.notes) {
      inputs.notes.addEventListener("input", () => {
        state.notes = inputs.notes.value;
      });
    }

    backBtn.addEventListener("click", () => {
      if (state.step === "contact") goToStep("schedule");
      else if (state.step === "confirm") goToStep("contact");
    });

    nextBtn.addEventListener("click", () => {
      if (state.step === "schedule") {
        if (state.selectedDate && state.selectedSlot !== null) {
          goToStep("contact");
        }
      } else if (state.step === "contact") {
        clearContactErrors();
        const v = isContactValid();
        if (!v.ok) {
          showFieldError(v.field, v.message);
          return;
        }
        goToStep("confirm");
      } else if (state.step === "confirm") {
        submit();
      }
    });

    // ── Init ────────────────────────────────────────────────────────
    renderWeekdays();
    renderCalendar();
    renderSlots();
    goToStep("schedule");
  }
</script>

