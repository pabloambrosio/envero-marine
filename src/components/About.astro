---
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="about" id="nosotros" aria-label={t("about.aria")}>
  <div class="about__container">
    <header class="about__head">
      <span class="about__eyebrow">{t("about.eyebrow")}</span>
    </header>

    <div class="about__bento">
      <article class="about__cell about__cell--intro">
        <span class="about__tag" aria-hidden="true">{t("about.tag.intro")}</span>
        <h2 class="about__heading">{t("about.heading")}</h2>
        <p class="about__lead">{t("about.lead")}</p>
      </article>

      <article
        class="about__cell about__cell--founders"
        role="img"
        aria-label={t("about.founders.label")}
      >
        <span class="about__tag about__tag--invert" aria-hidden="true">{t("about.tag.founders")}</span>
        <span class="about__foundersIcon" aria-hidden="true">
          <i class="fa-solid fa-user-tie" aria-hidden="true" />
          <i class="fa-solid fa-user-tie about__foundersIcon--shift" aria-hidden="true" />
        </span>
        <div class="about__foundersFoot">
          <span class="about__foundersLabel">{t("about.founders.label")}</span>
          <span class="about__foundersCaption">{t("about.founders.caption")}</span>
        </div>
      </article>

      <article class="about__cell about__cell--mission">
        <span class="about__tag" aria-hidden="true">{t("about.tag.mission")}</span>
        <span class="about__cellLabel">{t("about.mission.label")}</span>
        <p class="about__cellBody">{t("about.mission.body")}</p>
      </article>

      <article class="about__cell about__cell--vision">
        <span class="about__tag" aria-hidden="true">{t("about.tag.vision")}</span>
        <span class="about__cellLabel">{t("about.vision.label")}</span>
        <p class="about__cellBody">{t("about.vision.body")}</p>
      </article>

      <dl class="about__cell about__cell--meta">
        <div class="about__metaItem">
          <dt>{t("about.meta.base")}</dt>
          <dd>{t("about.meta.baseValue")}</dd>
        </div>
        <div class="about__metaItem">
          <dt>{t("about.meta.scope")}</dt>
          <dd>{t("about.meta.scopeValue")}</dd>
        </div>
        <div class="about__metaItem">
          <dt>{t("about.meta.year")}</dt>
          <dd>{t("about.meta.yearValue")}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .about__container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .about__head {
    margin-bottom: var(--space-5);
  }

  .about__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* ── bento grid ────────────────────────────────────────── */
  .about__bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      "intro intro founders"
      "mission vision founders"
      "meta meta meta";
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .about__cell {
    position: relative;
    background: var(--color-surface);
    padding: var(--space-6);
    min-width: 0;
  }

  .about__tag {
    display: block;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .about__tag--invert {
    color: rgba(245, 242, 236, 0.75);
  }

  /* ── intro cell (heading + lead) ──────────────────────── */
  .about__cell--intro {
    grid-area: intro;
    background: var(--color-bg);
    padding-block: var(--space-7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }

  .about__cell--intro::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 2px;
    background: var(--color-accent);
  }

  .about__heading {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    max-width: 22ch;
  }

  .about__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 60ch;
  }

  /* ── founders cell (photo placeholder) ────────────────── */
  .about__cell--founders {
    grid-area: founders;
    overflow: hidden;
    background-color: var(--color-primary);
    background-image:
      repeating-linear-gradient(
        -45deg,
        transparent 0,
        transparent 14px,
        rgba(245, 242, 236, 0.05) 14px,
        rgba(245, 242, 236, 0.05) 15px
      );
    color: var(--color-bg);
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 360px;
  }

  .about__cell--founders::after {
    content: "";
    position: absolute;
    inset: var(--space-3);
    border: 1px dashed rgba(245, 242, 236, 0.18);
    pointer-events: none;
  }

  .about__foundersIcon {
    position: relative;
    display: grid;
    place-items: center;
    color: rgba(245, 242, 236, 0.16);
    font-size: 5rem;
    line-height: 1;
    z-index: 1;
  }

  .about__foundersIcon :global(.fa-solid) {
    grid-column: 1;
    grid-row: 1;
    transition: transform 400ms var(--ease-out);
  }

  .about__foundersIcon--shift {
    transform: translate(28px, -6px);
    color: rgba(245, 242, 236, 0.1);
  }

  .about__foundersFoot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(245, 242, 236, 0.18);
  }

  .about__foundersLabel {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }

  .about__foundersCaption {
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: rgba(245, 242, 236, 0.7);
  }

  /* ── mission / vision cells ───────────────────────────── */
  .about__cell--mission {
    grid-area: mission;
  }

  .about__cell--vision {
    grid-area: vision;
  }

  .about__cell--mission::before,
  .about__cell--vision::before {
    content: "";
    position: absolute;
    top: var(--space-6);
    left: 0;
    width: 2px;
    height: 28px;
    background: var(--color-accent);
  }

  .about__cellLabel {
    display: block;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .about__cellBody {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--color-ink);
  }

  /* ── meta strip ───────────────────────────────────────── */
  .about__cell--meta {
    grid-area: meta;
    background: var(--color-bg);
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 0;
  }

  .about__metaItem {
    background: var(--color-bg);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: relative;
  }

  .about__metaItem + .about__metaItem::before {
    content: "";
    position: absolute;
    top: var(--space-5);
    bottom: var(--space-5);
    left: 0;
    width: 1px;
    background: var(--color-line);
  }

  .about__metaItem dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .about__metaItem dd {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.4;
    color: var(--color-ink);
  }

  /* ── tablet ───────────────────────────────────────────── */
  @media (max-width: 960px) {
    .about {
      padding: var(--space-7) 0;
    }

    .about__bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "intro intro"
        "founders founders"
        "mission vision"
        "meta meta";
    }

    .about__cell {
      padding: var(--space-5);
    }

    .about__cell--founders {
      min-height: 240px;
    }

    .about__heading {
      font-size: var(--fs-xl);
    }

    .about__cell--meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ── mobile ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .about {
      padding: var(--space-6) 0;
    }

    .about__bento {
      grid-template-columns: 1fr;
      grid-template-areas:
        "intro"
        "founders"
        "mission"
        "vision"
        "meta";
    }

    .about__cell {
      padding: var(--space-4);
    }

    .about__cell--intro {
      padding-block: var(--space-5);
    }

    .about__cell--founders {
      min-height: 200px;
    }

    .about__heading {
      font-size: var(--fs-lg);
    }

    .about__lead,
    .about__cellBody {
      font-size: var(--fs-sm);
    }

    .about__cell--meta {
      grid-template-columns: 1fr;
    }

    .about__metaItem + .about__metaItem::before {
      top: 0;
      bottom: auto;
      left: var(--space-5);
      right: var(--space-5);
      width: auto;
      height: 1px;
    }
  }
</style>
