---
import { resolveLang, useTranslations } from "../../i18n/utils";
import BookingCalendar from "./BookingCalendar.astro";
import BookingForm from "./BookingForm.astro";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<aside
  class="wizard"
  data-booking-wizard
  data-lang={lang}
  aria-label={t("booking.eyebrow")}
>
  <span class="eyebrow wizard__eyebrow">{t("booking.eyebrow")}</span>

  <div class="wizard__step" data-step="1">
    <h2 class="wizard__title">{t("booking.step1.title")}</h2>
    <BookingCalendar />
  </div>

  <div class="wizard__step" data-step="2" hidden>
    <h2 class="wizard__title">{t("booking.step2.title")}</h2>
    <BookingForm />
  </div>

  <div class="wizard__step wizard__step--done" data-step="3" hidden>
    <span class="eyebrow wizard__eyebrow wizard__eyebrow--done">
      {t("booking.step3.eyebrow")}
    </span>
    <p class="wizard__body">{t("booking.step3.body")}</p>
    <button type="button" class="btn btn--ghost wizard__reset" data-booking-reset>
      <span>{t("booking.step3.reset")}</span>
    </button>
  </div>
</aside>

<script>
  type Step = 1 | 2 | 3;

  const wizard = document.querySelector<HTMLElement>("[data-booking-wizard]");

  if (wizard) {
    const lang = wizard.dataset.lang ?? "es";
    const steps = wizard.querySelectorAll<HTMLElement>(".wizard__step");
    const eyebrowEl = wizard.querySelector<HTMLElement>(
      ".wizard__eyebrow:not(.wizard__eyebrow--done)"
    );
    const dateDisplay = wizard.querySelector<HTMLElement>("[data-booking-date]");
    const form = wizard.querySelector<HTMLFormElement>("[data-booking-form]");
    const backBtn = wizard.querySelector<HTMLButtonElement>("[data-booking-back]");
    const resetBtn = wizard.querySelector<HTMLButtonElement>(
      "[data-booking-reset]"
    );

    const dateFmt = new Intl.DateTimeFormat(lang, {
      weekday: "short",
      day: "2-digit",
      month: "short",
      year: "numeric",
    });

    let currentStep: Step = 1;
    let selectedDate: Date | null = null;

    function formatSelectedDate(d: Date): string {
      const parts = dateFmt.formatToParts(d);
      const wd = parts.find((p) => p.type === "weekday")?.value ?? "";
      const day = parts.find((p) => p.type === "day")?.value ?? "";
      const month = parts.find((p) => p.type === "month")?.value ?? "";
      const year = parts.find((p) => p.type === "year")?.value ?? "";
      return `${wd} ${day} ${month} ${year}`.replace(/\./g, "").toUpperCase();
    }

    function applyState() {
      steps.forEach((s) => {
        const sn = Number(s.dataset.step);
        s.hidden = sn !== currentStep;
      });
      if (eyebrowEl) eyebrowEl.hidden = currentStep === 3;
      if (dateDisplay && selectedDate) {
        dateDisplay.textContent = formatSelectedDate(selectedDate);
      }
    }

    document.addEventListener("booking:date-selected", (e: Event) => {
      const detail = (e as CustomEvent<{ date: Date }>).detail;
      selectedDate = detail.date;
      currentStep = 2;
      applyState();
    });

    backBtn?.addEventListener("click", () => {
      currentStep = 1;
      applyState();
    });

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      currentStep = 3;
      applyState();
    });

    resetBtn?.addEventListener("click", () => {
      currentStep = 1;
      selectedDate = null;
      form?.reset();
      document.dispatchEvent(new CustomEvent("booking:reset"));
      applyState();
    });

    applyState();
  }
</script>

<style>
  .wizard {
    width: 100%;
    max-width: 480px;
    padding: var(--space-6);
    border: 1px solid rgba(255, 255, 255, 0.16);
    background-color: rgba(255, 255, 255, 0.025);
    backdrop-filter: blur(2px);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .wizard__eyebrow {
    color: var(--color-accent);
  }

  .wizard__eyebrow--done {
    color: var(--color-accent-soft);
  }

  .wizard__step {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .wizard__step[hidden] {
    display: none;
  }

  .wizard__title {
    font-size: var(--fs-xl);
    font-weight: 500;
    color: #fff;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .wizard__step--done {
    gap: var(--space-4);
    padding: var(--space-3) 0;
  }

  .wizard__body {
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.5;
    max-width: 36ch;
  }

  .wizard__reset {
    align-self: flex-start;
    margin-top: var(--space-3);
  }

  @media (max-width: 1024px) {
    .wizard {
      max-width: none;
    }
  }
</style>
