---
import Icon from "./Icon.astro";
import type { FaIconName } from "../icons/fa";
import { resolveLang } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const lang = resolveLang(Astro.currentLocale);

type LocalizedString = Record<Lang, string>;

interface Logo {
  src: string;
  alt: string;
}

interface Feature {
  id: string;
  icon?: FaIconName;
  logos?: Logo[];
  featured?: boolean;
  title: LocalizedString;
  description: LocalizedString;
}

const features: Feature[] = [
  
  {
    id: "business-engineering",
    icon: "gears",
    title: {
      es: "Ingeniería especializada",
      en: "Specialized engineering",
    },
    description: {
      es: "Arquitectura e ingeniería naval, fabricación de estructuras metálicas y proyectos eléctricos e iluminación — entregado bajo una sola firma.",
      en: "Naval architecture and marine engineering, metal structure fabrication, and electrical and lighting projects — delivered by a single firm.",
    },
  },
  {
    id: "brands",
    featured: true,
    logos: [
      { src: "/logos/totalenergies.svg", alt: "TotalEnergies" },
      { src: "/logos/current-technology.webp", alt: "Current Technology" },
      { src: "/logos/qer.png", alt: "Qer" },
      { src: "/logos/fonroche.webp", alt: "Fonroche Lighting America" },
    ],
    title: {
      es: "Suministro oficial de marcas globales",
      en: "Official supply from global brands",
    },
    description: {
      es: "Producto original con respaldo de fabricantes TotalEnergies, Current Technology, Qer y Fonroche Lighting America — el estándar de fábrica entregado desde su canal autorizado.",
      en: "Original product backed by manufacturers TotalEnergies, Current Technology, Qer and Fonroche Lighting America — factory standard delivered through their authorized channel.",
    },
  },
  {
    id: "project",
    icon: "compass-drafting",
    title: {
      es: "Desarrollo de proyectos",
      en: "Project development",
    },
    description: {
      es: "Tomamos tu propuesta — un parque, una embarcación, una repotenciación — y la convertimos en un plan ejecutable: ingeniería, fabricación, cobertura legal y experiencia de campo, consolidado por Envero.",
      en: "We take your proposal — a park, a vessel, a repowering — and turn it into an executable plan: engineering, fabrication, legal coverage and field experience, consolidated by Envero.",
    },
  },
];

const heading: LocalizedString = {
  es: "Soluciones a la medida de tu operación, no del catálogo.",
  en: "Solutions tailored to your operation, not the catalog.",
};

const lead: LocalizedString = {
  es: "6 proveedores en una sola conversación.",
  en: "6 suppliers in a single conversation.",
};

const aria: LocalizedString = {
  es: "Capacidades de Envero",
  en: "Envero capabilities",
};
---

<section class="features" id="capacidades" aria-label={aria[lang]}>
  <div class="features__layout">
    <header class="features__head">
      <h2 class="features__heading">{heading[lang]}</h2>
      <p class="features__lead">{lead[lang]}</p>
    </header>

    <ul class="features__grid">
      {
        features.map((feature) => (
          <li class:list={["features__card", feature.featured && "features__card--featured"]}>
            {feature.logos ? (
              <div class="features__logos">
                {feature.logos.map((logo) => (
                  <span class="features__logo-cell">
                    <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
                  </span>
                ))}
              </div>
            ) : (
              <span class="features__icon" aria-hidden="true">
                <Icon name={feature.icon!} />
              </span>
            )}
            <h3 class="features__title">{feature.title[lang]}</h3>
            <p class="features__desc">{feature.description[lang]}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .features__layout {
    /* max-width: var(--container-max); */
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-inline: auto;
    padding: var(--space-7) max(var(--space-4), calc((100vw - var(--container-max)) / 2 + var(--space-4)));
    /* background-color: #EAE7DF; */
  }

  .features__head {
    max-width: 720px;
    margin-bottom: var(--space-7);
  }

  .features__heading {
    margin: 0 0 var(--space-4);
    font-size: clamp(2.25rem, 1.5rem + 2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.032em;
    color: var(--color-primary);
    text-align: center;
  }

  .features__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-ink-muted);
    text-align: center;
  }

  .features__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-6);
    align-items: stretch;
  }

  .features__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    flex: 1 1 0;
    min-width: 0;
  }

  .features__card--featured {
    flex-grow: 1.1;
    transform: scale(1.1);
  }

  .features__icon {
    display: grid;
    place-items: center;
    width: 100%;
    height: 200px;
    color: var(--color-primary);
  }

  .features__icon :global(.fa-solid) {
    font-size: 5rem;
    line-height: 1;
  }

  .features__logos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /* gap: var(--space-2); */
    width: 100%;
  }

  .features__logo-cell {
    display: grid;
    place-items: center;
    flex: 1 1 0;
    min-width: 0;
    height: 90px;
    padding: var(--space-3);
    /* border: 1px solid var(--color-line); */
    /* background: var(--color-bg); */
  }

  .features__logo-cell img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
  }

  .features__title {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-primary);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .features__desc {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  @media (max-width: 960px) {
    .features__layout {
      padding: var(--space-6) var(--space-5);
    }

    .features__head {
      margin-bottom: var(--space-6);
    }

    .features__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .features__card {
      padding: var(--space-5);
    }
  }

  @media (max-width: 640px) {
    .features__heading {
      font-size: clamp(1.8rem, 7.5vw, 2.4rem);
    }

    .features__lead {
      font-size: var(--fs-sm);
    }

    .features__icon {
      height: 140px;
    }

    .features__icon :global(.fa-solid) {
      font-size: 4rem;
    }

    .features__title {
      font-size: var(--fs-md);
    }
  }
</style>
