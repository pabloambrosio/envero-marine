---
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <span class="eyebrow hero__eyebrow">{t("hero.eyebrow")}</span>
      <h1 class="hero__title">
        {t("hero.title.lead")}<em class="hero__title-emph">{t("hero.title.emph")}</em>{t("hero.title.tail")}
      </h1>
      <ul class="hero__checks" aria-label={t("hero.checks.aria")}>
        <li>{t("hero.checks.local")}</li>
        <li>{t("hero.checks.experts")}</li>
        <li>{t("hero.checks.brands")}</li>
      </ul>

      <div class="hero__actions">
        <a href="#contacto" class="btn btn--primary">
          <span>{t("hero.cta.primary")}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a href="#servicios" class="btn btn--ghost">
          <span>{t("hero.cta.secondary")}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="hero__stats" aria-label={t("hero.stats.aria")}>
        <li>
          <strong>6</strong>
          <span>{t("hero.stats.lines")}</span>
        </li>
        <li>
          <strong>4</strong>
          <span>{t("hero.stats.brands")}</span>
        </li>
        <li>
          <strong>1</strong>
          <span>{t("hero.stats.base")}</span>
        </li>
      </ul>
    </div>

    <div class="hero__aside" aria-hidden="true">
      <figure class="hero__collage">
        <img
          class="hero__img hero__img--alt hero__img--top"
          src="/hero/engineer-blueprint.jpg"
          alt=""
          loading="eager"
          decoding="async"
          width="896"
          height="1200"
        />
        <img
          class="hero__img hero__img--micro hero__img--micro-tr"
          src="/hero/platform-dawn.jpg"
          alt=""
          loading="eager"
          decoding="async"
          width="896"
          height="1200"
        />
        <img
          class="hero__img hero__img--main"
          src="/hero/operators-tablet.jpg"
          alt=""
          loading="eager"
          decoding="async"
          width="896"
          height="1200"
        />
        <img
          class="hero__img hero__img--micro hero__img--micro-bl"
          src="/hero/vessel-blueprint.jpg"
          alt=""
          loading="eager"
          decoding="async"
          width="896"
          height="1200"
        />
        <img
          class="hero__img hero__img--alt hero__img--bottom"
          src="/hero/technician-panel.jpg"
          alt=""
          loading="eager"
          decoding="async"
          width="1024"
          height="1024"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 80vh;
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: var(--space-9);
    color: #fff;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--color-primary-deep) 0%,
      var(--color-primary) 55%,
      var(--color-primary-soft) 100%
    );
  }

  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: linear-gradient(
        to right,
        rgba(255, 255, 255, 0.05) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: var(--space-8);
    align-items: center;
  }

  .hero__content {
    max-width: 820px;
  }

  .hero__aside {
    display: flex;
    justify-content: flex-end;
  }

  .hero__collage {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
  }

  .hero__img {
    position: absolute;
    display: block;
    height: auto;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background-color: var(--color-primary-deep);
  }

  .hero__img--main {
    top: 50%;
    left: 50%;
    width: 78%;
    aspect-ratio: 3 / 4;
    transform: translate(-50%, -50%);
    z-index: 2;
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .hero__img--alt {
    width: 62%;
    aspect-ratio: 1 / 1;
    z-index: 1;
    opacity: 0.95;
  }

  .hero__img--top {
    top: 4%;
    left: -28%;
  }

  .hero__img--bottom {
    bottom: 2%;
    right: -30%;
  }

  .hero__img--micro {
    width: 26%;
    aspect-ratio: 1 / 1;
    z-index: 1;
    opacity: 0.88;
    border-color: rgba(255, 255, 255, 0.14);
  }

  .hero__img--micro-tr {
    top: 2%;
    right: 2%;
  }

  .hero__img--micro-bl {
    bottom: 6%;
    left: 2%;
  }

  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      align-items: stretch;
    }
    .hero__aside {
      justify-content: center;
    }
    .hero__collage {
      max-width: 420px;
      aspect-ratio: 5 / 4;
    }
    .hero__img--main {
      width: 50%;
    }
    .hero__img--alt {
      width: 36%;
    }
    .hero__img--top {
      top: 8%;
      left: 2%;
    }
    .hero__img--bottom {
      bottom: 6%;
      right: 2%;
    }
    .hero__img--micro {
      width: 18%;
    }
    .hero__img--micro-tr {
      top: 4%;
      right: 4%;
    }
    .hero__img--micro-bl {
      bottom: 8%;
      left: 4%;
    }
  }

  @media (max-width: 560px) {
    .hero__collage {
      max-width: 360px;
    }
  }

  .hero__eyebrow {
    border: 1px solid var(--color-accent);
    padding: 0.35rem 0.65rem;
    background-color: rgba(0, 0, 0, 0.55);
    color: #fff;
  }

  .hero__eyebrow::before {
    display: none;
  }

  .hero__title {
    margin-top: var(--space-5);
    font-size: var(--fs-4xl);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .hero__title-emph {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }

  .hero__checks {
    margin-top: var(--space-5);
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 56ch;
  }

  .hero__checks li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.92);
  }

  .hero__checks li::before {
    content: "";
    width: 16px;
    height: 16px;
    flex: none;
    background-color: var(--color-accent);
    background-image: url("data:image/svg+xml;utf8,%3Csvg viewBox='0 0 16 16' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3.5 8.5l3 3 6-6' stroke='white' stroke-width='2.25' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-size: 12px;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero__actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__stats {
    margin-top: var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin-bottom: 0;
    max-width: 720px;
  }

  .hero__stats li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) 0 0;
  }

  .hero__stats li + li {
    border-left: 1px solid rgba(255, 255, 255, 0.14);
    padding-left: var(--space-5);
  }

  .hero__stats strong {
    font-family: var(--font-mono);
    font-size: var(--fs-3xl);
    font-weight: 500;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hero__stats span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 720px) {
    .hero__stats {
      grid-template-columns: 1fr;
    }
    .hero__stats li + li {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      padding-left: 0;
      padding-top: var(--space-4);
    }
  }
</style>
