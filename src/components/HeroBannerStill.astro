---
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="hero hero__bg">
  <!-- <div class="hero__bg" aria-hidden="true"></div> -->
  <div class="container hero__inner">
    <div class="hero__content">
      <span class="eyebrow hero__eyebrow">{t("hero.eyebrow")}</span>
      <h1 class="hero__title">
        {t("hero.title.lead")}<em class="hero__title-emph">{t("hero.title.emph")}</em>{t("hero.title.mid")}<em class="hero__title-emph">{t("hero.title.emph2")}</em>{t("hero.title.tail")}
      </h1>
      <ul class="hero__checks" aria-label={t("hero.checks.aria")}>
        <li>{t("hero.checks.local")}</li>
        <li>{t("hero.checks.experts")}</li>
        <li>{t("hero.checks.brands")}</li>
      </ul>

      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary">
          <span>{t("hero.cta.primary")}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a href="#capacidades" class="btn btn--ghost">
          <span>{t("hero.cta.secondary")}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="hero__stats" aria-label={t("hero.stats.aria")}>
        <li>
          <strong>6</strong>
          <span>{t("hero.stats.lines")}</span>
        </li>
        <li>
          <strong>4</strong>
          <span>{t("hero.stats.brands")}</span>
        </li>
        <li>
          <strong>1</strong>
          <span>{t("hero.stats.base")}</span>
        </li>
      </ul>
    </div>

    <div class="hero__aside" aria-hidden="true">
      <figure class="hero__collage">
        <img
          class="hero__img hero__img--main"
          src="/hero/operators-tablet.jpg"
          alt=""
          loading="eager"
          decoding="async"
          width="896"
          height="1200"
        />
        <img
          class="hero__img hero__img--pip"
          src="/hero/engineer-blueprint.jpg"
          alt=""
          loading="eager"
          decoding="async"
          width="896"
          height="1200"
        />
      </figure>
      <figure class="hero__video">
        <video
          class="hero__video-el"
          src="/hero/herobanner.webm"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          width="1692"
          height="952"
        ></video>
      </figure>
    </div>
  </div>
</section>

<script>
  const v = document.querySelector<HTMLVideoElement>(".hero__video-el");
  if (v) {
    v.defaultPlaybackRate = 0.5;
    v.playbackRate = 0.5;
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--hero-peek, 140px));
    padding-top: calc(var(--header-height) + var(--space-5));
    padding-bottom: var(--space-5);
    color: #fff;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .hero__bg {
    background: linear-gradient(
      135deg,
      var(--color-primary-deep) 0%,
      var(--color-primary) 55%,
      var(--color-primary-soft) 100%
    );
  }

  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
        to right,
        rgba(255, 255, 255, 0.05) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    background-attachment: fixed;
    mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
    animation: grid-drift 5s linear infinite;
  }

  @keyframes grid-drift {
    from { background-position: 0 0; }
    to   { background-position: -56px -56px; }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: var(--space-8);
    align-items: center;
  }

  .hero__content {
    max-width: 820px;
    min-width: 0;
  }

  .hero__aside {
    display: flex;
    justify-content: flex-end;
    min-width: 0;
  }

  .hero__collage {
    position: relative;
    width: 100%;
    max-width: min(520px, 56vh);
    aspect-ratio: 5 / 6;
    margin: 0;
  }

  .hero__video {
    display: none;
    position: relative;
    width: 100%;
    margin: 0;
    aspect-ratio: 21 / 9;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background-color: var(--color-primary-deep);
  }

  .hero__video::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 15%,
      rgba(0, 0, 0, 0.82) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero__video::after {
    content: "";
    position: absolute;
    inset: -10px;
    border: 3px solid rgba(255, 255, 255, 0.22);
    translate: 14px 14px;
    z-index: 1;
    pointer-events: none;
  }

  .hero__video-el {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__collage::after {
    content: "";
    position: absolute;
    inset: -10px;
    border: 3px solid rgba(255, 255, 255, 0.22);
    translate: 14px 14px;
    z-index: 1;
    pointer-events: none;
  }

  .hero__img {
    position: absolute;
    display: block;
    height: auto;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background-color: var(--color-primary-deep);
  }

  .hero__img--main {
    inset: -10px;
    aspect-ratio: 3 / 4;
    z-index: 2;
    border-color: rgba(255, 255, 255, 0.32);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .hero__img--pip {
    width: 60%;
    aspect-ratio: 1 / 1;
    bottom: -5%;
    left: -15%;
    z-index: 3;
    border: 1px solid rgba(255, 255, 255, 0.1);
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5), 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  .hero__eyebrow {
    border: 1px solid var(--color-accent);
    padding: 0.35rem 0.65rem;
    background-color: rgba(0, 0, 0, 0.55);
    color: #fff;
  }

  .hero__eyebrow::before {
    display: none;
  }

  .hero__title {
    margin-top: var(--space-4);
    font-size: clamp(2.25rem, min(6vw, 7.2vh), 5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .hero__title-emph {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }

  .hero__checks {
    margin-top: var(--space-4);
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 56ch;
  }

  .hero__checks li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.92);
  }

  .hero__checks li::before {
    content: "";
    width: 16px;
    height: 16px;
    flex: none;
    background-color: var(--color-accent);
    background-image: url("data:image/svg+xml;utf8,%3Csvg viewBox='0 0 16 16' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3.5 8.5l3 3 6-6' stroke='white' stroke-width='2.25' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-size: 12px;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero__actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__stats {
    margin-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin-bottom: 0;
    max-width: 720px;
  }

  .hero__stats li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) 0 0;
  }

  .hero__stats li + li {
    border-left: 1px solid rgba(255, 255, 255, 0.14);
    padding-left: var(--space-5);
  }

  .hero__stats strong {
    font-family: var(--font-mono);
    font-size: var(--fs-3xl);
    font-weight: 500;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hero__stats span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.55);
  }

  /* ── tablet ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero {
      padding-top: calc(var(--header-height) + var(--space-7));
      padding-bottom: var(--space-8);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      align-items: stretch;
    }

    .hero__aside {
      order: -1;
      justify-content: stretch;
    }

    .hero__content {
      margin-top: calc((var(--space-7) + var(--space-9)) * -1);
      position: relative;
      z-index: 2;
    }

    .hero__collage {
      display: none;
    }

    .hero__video {
      display: block;
      max-width: none;
    }
  }

  /* ── mobile ─────────────────────────────────────────── */
  @media (max-width: 640px) {
    .hero {
      min-height: 0;
      padding-top: calc(var(--header-height) + var(--space-6));
      padding-bottom: var(--space-6);
    }

    .hero__title {
      margin-top: var(--space-4);
    }

    .hero__checks {
      margin-top: var(--space-5);
      gap: var(--space-2);
    }

    .hero__checks li {
      font-size: var(--fs-sm);
    }

    .hero__actions {
      margin-top: var(--space-6);
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      justify-content: space-between;
    }

    .hero__stats {
      display: none;
    }

    .hero__video {
      max-width: 100%;
    }
  }
</style>
