---
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

// Iconos de trazo fino (blueprint industrial: sin relleno, esquinas a escuadra).
const icons: Record<string, string> = {
  storage: '<path d="M3 14h7v7H3zM14 14h7v7h-7zM8.5 3h7v7h-7z"/>',
  structure: '<path d="M3 21 12 3l9 18M3 21h18M6.5 14h11"/>',
  access: '<path d="M8 3v18M16 3v18M8 8h8M8 12h8M8 16h8"/>',
  safety:
    '<path d="M12 3 4 6v6c0 4.5 4 7.5 8 9 4-1.5 8-4.5 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>',
  ducts: '<path d="M2 8h20M2 16h20M7 8v8M17 8v8"/>',
  coating: '<path d="M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5"/>',
};

// Fila 1: 3 celdas, cada una con 2 mini cards. Fila 2 (full): galería de 3 imágenes.
const cells = [
  {
    cards: [
      {
        icon: "storage",
        title: "Almacenamiento y transporte",
        subtitle: "Racks, bastidores, canastillas, cajas y contenedores",
      },
      {
        icon: "structure",
        title: "Estructura y soportería",
        subtitle: "Estructuras para techumbres y cubiertas, más bases para equipos",
      },
    ],
  },
  {
    cards: [
      {
        icon: "access",
        title: "Accesos y habilitación naval",
        subtitle: "Escaleras marinas, escotillas, pasamanos y plataformas de acceso",
      },
      {
        icon: "safety",
        title: "Protección y seguridad industrial",
        subtitle: "Barandales, rejillas, protecciones y guardas para equipos",
      },
    ],
  },
  {
    cards: [
      {
        icon: "ducts",
        title: "Conducción y manejo de materiales",
        subtitle: "Ductos metálicos y tolvas para líneas de conducción y descarga",
      },
      {
        icon: "coating",
        title: "Tratamiento anticorrosivo",
        subtitle: "Acabado protector que se aplica sobre toda la estructura fabricada",
      },
    ],
  },
];

const gallery = [
  { src: "/metalurgia/ahsanization-mJi2I9KJPQ8-unsplash.jpg", alt: "" },
  { src: "/metalurgia/jason-richard-Hlhc8gQUW6I-unsplash.jpg", alt: "" },
  { src: "/metalurgia/morteza-mohammadi-ZkvJnta6bAI-unsplash.jpg", alt: "" },
];
---

<section class="met" id="fabricacion" aria-label={t("metalurgia.aria")}>
  <div class="met__container">
    <header class="met__head">
      <h2 class="met__heading">
        {t("metalurgia.heading.lead")}<em class="met__headingEmph"
          >{t("metalurgia.heading.emph")}</em
        >{t("metalurgia.heading.tail")}
      </h2>

      <p class="met__lead">{t("metalurgia.lead")}</p>
    </header>

    <div class="met__grid">
      {
        cells.map((cell) => (
          <div class="met__cell">
            <div class="met__cards">
              {cell.cards.map((card) => (
                <div class="met__miniCard">
                  <svg
                    class="met__miniIcon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                    set:html={icons[card.icon]}
                  />

                  <div class="met__miniText">
                    <span class="met__miniTitle">{card.title}</span>
                    <span class="met__miniSub">{card.subtitle}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }

      <div class="met__cell met__cell--full">
        <div class="met__gallery">
          {
            gallery.map((img) => (
              <img
                class="met__galleryImg"
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .met {
    position: relative;
    isolation: isolate;
    padding: var(--space-8) 0;
    background-color: var(--color-bg);
    color: var(--color-ink);
    overflow: hidden;
  }

  /* hairline grid background — same grammar as the other cream sections */
  .met::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(14, 61, 52, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(14, 61, 52, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  .met__container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  /* ── heading ───────────────────────────────────────────── */
  .met__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);

  }

  .met__heading {
    margin: 0;
    font-size: clamp(2.1rem, 1.3rem + 2.4vw, 3.4rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    /* max-width: 18ch; */
  }

  .met__headingEmph {
    font-family: var(--font-display), serif;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }

  .met__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  /* ── grid 3 × 2 (placeholder) ──────────────────────────── */
  .met__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(200px, auto);
    gap: var(--space-5);
  }

  .met__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0;
    border: none;
    background: transparent;
  }

  /* ── mini cards dentro de cada celda ───────────────────── */
  .met__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
    justify-content: center;
  }

  .met__miniCard {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-surface);
  }

  .met__miniIcon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    color: var(--color-primary);
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .met__miniText {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .met__miniTitle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
  }

  .met__miniSub {
    font-size: var(--fs-sm);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
  }

  /* última celda — ocupa las 3 columnas y 2 filas de alto */
  .met__cell--full {
    grid-column: 1 / -1;
    grid-row: span 2;
    /* sin padding/place-items: la galería ocupa toda la celda */
    display: block;
    padding: 0;
    border: none;
    background: transparent;
  }

  /* galería de 3 imágenes dentro de la celda grande */
  .met__gallery {
    width: 100%;
    height: 100%;
    display: flex;
    gap: var(--space-4);
  }

  .met__galleryImg {
    flex: 1 1 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left left;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-surface);
  }

  /* la imagen central crece el doble que las laterales */
  .met__galleryImg:nth-child(2) {
    flex-grow: 2;
  }

  /* ── tablet ───────────────────────────────────────────── */
  @media (max-width: 960px) {
    .met {
      padding: var(--space-7) 0;
    }

    .met__container {
      gap: var(--space-6);
    }

    .met__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ── mobile ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .met {
      padding: var(--space-6) 0;
    }

    .met__heading {
      font-size: clamp(1.8rem, 7vw, 2.4rem);
    }

    .met__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 140px;
      gap: var(--space-4);
    }

    /* la celda grande deja de medir 2 filas fijas y la galería se apila */
    .met__cell--full {
      grid-row: auto;
    }

    .met__gallery {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .met__galleryImg {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
