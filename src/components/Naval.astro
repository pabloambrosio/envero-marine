---
import { resolveLang, useTranslations } from "../i18n/utils";
import type { TranslationKey } from "../i18n/ui";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const partKeys: TranslationKey[] = [
  "naval.parts.item.01",
  "naval.parts.item.02",
  "naval.parts.item.03",
  "naval.parts.item.04",
  "naval.parts.item.05",
  "naval.parts.item.06",
  "naval.parts.item.07",
  "naval.parts.item.08",
  "naval.parts.item.09",
  "naval.parts.item.10",
  "naval.parts.item.11",
  "naval.parts.item.12",
];
---

<section class="naval" id="naval" aria-label={t("naval.aria")}>
  <div class="naval__container">
    <div class="naval__top">
      <div class="naval__textCol">
        <span class="naval__eyebrow">{t("naval.eyebrow")}</span>

        <h2 class="naval__heading">
          {t("naval.heading.lead")}<em class="naval__headingEmph"
            >{t("naval.heading.emph")}</em
          >{t("naval.heading.tail")}
        </h2>

        <p class="naval__lead">{t("naval.lead")}</p>

        <dl class="naval__meta">
          <div class="naval__metaItem">
            <dt>{t("naval.meta.sector")}</dt>
            <dd>{t("naval.meta.sectorValue")}</dd>
          </div>
          <div class="naval__metaItem">
            <dt>{t("naval.meta.deliverable")}</dt>
            <dd>{t("naval.meta.deliverableValue")}</dd>
          </div>
          <div class="naval__metaItem">
            <dt>{t("naval.meta.class")}</dt>
            <dd>{t("naval.meta.classValue")}</dd>
          </div>
        </dl>

        <button
          type="button"
          class="btn btn--primary naval__cta"
          data-open-modal="appointment"
        >
          <span>{t("naval.cta")}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>

      <figure class="naval__plate" aria-labelledby="naval-plate-caption">
        <span class="naval__corner naval__corner--tl" aria-hidden="true"></span>
        <span class="naval__corner naval__corner--tr" aria-hidden="true"></span>
        <span class="naval__corner naval__corner--bl" aria-hidden="true"></span>
        <span class="naval__corner naval__corner--br" aria-hidden="true"></span>

        <span class="naval__cote naval__cote--top" aria-hidden="true">
          <span>{t("naval.dwg")}</span>
          <span class="naval__coteSep">·</span>
          <span>{t("naval.scale")}</span>
        </span>

        <span class="naval__cote naval__cote--right" aria-hidden="true">
          <span class="naval__tick"></span>
          <span class="naval__tick"></span>
          <span class="naval__tick"></span>
          <span class="naval__tick"></span>
        </span>

        <span class="naval__cote naval__cote--bottom" aria-hidden="true">
          <span>{t("naval.rev")}</span>
        </span>

        <div class="naval__plateInner">
          <img
            class="naval__img"
            src="/naval/osv-pemex-blueprint.jpeg"
            alt={t("naval.imageAlt")}
            loading="lazy"
            decoding="async"
            width="1200"
            height="900"
          />
        </div>

        <figcaption id="naval-plate-caption" class="naval__plateCaption">
          <span>{t("naval.imageAlt")}</span>
        </figcaption>
      </figure>
    </div>

    <div class="naval__parts">
      <header class="naval__partsHead">
        <span class="naval__partsTag">{t("naval.parts.tag")}</span>
        <h3 class="naval__partsHeading">{t("naval.parts.heading")}</h3>
      </header>

      <ol class="naval__partsList">
        {
          partKeys.map((key, i) => (
            <li class="naval__part">
              <span class="naval__partNum" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="naval__partLabel">{t(key)}</span>
              <span class="naval__partLead" aria-hidden="true" />
              <span class="naval__partMark" aria-hidden="true">→</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .naval {
    position: relative;
    isolation: isolate;
    padding: var(--space-8) 0;
    background-color: var(--color-primary-deep);
    color: var(--color-bg);
    overflow: hidden;
  }

  /* hairline grid in light-on-dark — mirror of Metalurgia */
  .naval::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(245, 242, 236, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(245, 242, 236, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  .naval__container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: grid;
    gap: var(--space-8);
  }

  /* ── top zone ─────────────────────────────────────────── */
  .naval__top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: stretch;
  }

  .naval__textCol {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-3);
  }

  .naval__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .naval__heading {
    margin: 0;
    font-size: clamp(2.1rem, 1.3rem + 2.4vw, 3.4rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: #fff;
    max-width: 16ch;
  }

  .naval__headingEmph {
    font-family: var(--font-display), serif;
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }

  .naval__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: rgba(245, 242, 236, 0.72);
    max-width: 44ch;
  }

  .naval__meta {
    margin: var(--space-2) 0 0;
    padding: var(--space-4) 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    border-top: 1px solid rgba(245, 242, 236, 0.16);
    border-bottom: 1px solid rgba(245, 242, 236, 0.16);
  }

  .naval__metaItem {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .naval__metaItem dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.55);
  }

  .naval__metaItem dd {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.35;
    color: var(--color-bg);
  }

  .naval__cta {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  /* ── plate ────────────────────────────────────────────── */
  .naval__plate {
    position: relative;
    margin: 0;
    padding: var(--space-6) var(--space-5) var(--space-7);
    background: var(--color-primary);
    border: 1px solid rgba(245, 242, 236, 0.18);
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  .naval__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--color-accent);
    pointer-events: none;
  }
  .naval__corner--tl {
    top: 6px;
    left: 6px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .naval__corner--tr {
    top: 6px;
    right: 6px;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .naval__corner--bl {
    bottom: 6px;
    left: 6px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .naval__corner--br {
    bottom: 6px;
    right: 6px;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }

  .naval__cote {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.6);
  }
  .naval__coteSep {
    opacity: 0.45;
  }

  .naval__cote--top {
    top: -7px;
    left: var(--space-6);
    padding-inline: var(--space-2);
    background: var(--color-primary-deep);
  }
  .naval__cote--bottom {
    bottom: -7px;
    right: var(--space-6);
    padding-inline: var(--space-2);
    background: var(--color-primary-deep);
  }
  .naval__cote--right {
    top: 50%;
    right: -1px;
    transform: translateY(-50%);
    flex-direction: column;
    gap: 14px;
    padding-block: var(--space-3);
  }
  .naval__tick {
    width: 8px;
    height: 1px;
    background: rgba(245, 242, 236, 0.4);
  }

  .naval__plateInner {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    padding: var(--space-3);
    background: var(--color-primary-deep);
    overflow: hidden;
  }

  .naval__plateInner::before,
  .naval__plateInner::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }
  .naval__plateInner::before {
    left: 50%;
    top: 8%;
    bottom: 8%;
    width: 1px;
    background: rgba(245, 242, 236, 0.08);
  }
  .naval__plateInner::after {
    top: 50%;
    left: 8%;
    right: 8%;
    height: 1px;
    background: rgba(245, 242, 236, 0.08);
  }

  .naval__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    max-height: 540px;
    object-fit: contain;
  }

  .naval__plateCaption {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed rgba(245, 242, 236, 0.18);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.55);
  }

  /* ── parts list ───────────────────────────────────────── */
  .naval__parts {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .naval__partsHead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(245, 242, 236, 0.18);
  }

  .naval__partsHeading {
    margin: 0;
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .naval__partsTag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.55);
  }

  .naval__partsList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-7);
    row-gap: 0;
  }

  .naval__part {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(245, 242, 236, 0.14);
    transition: padding-left 220ms var(--ease-out);
  }

  .naval__part::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 220ms var(--ease-out);
  }

  .naval__part:hover {
    padding-left: var(--space-3);
  }
  .naval__part:hover::before {
    transform: scaleY(1);
    transform-origin: top;
  }

  .naval__partNum {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: rgba(245, 242, 236, 0.55);
    transition: color 220ms var(--ease-out);
  }

  .naval__part:hover .naval__partNum {
    color: var(--color-accent);
  }

  .naval__partLabel {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-bg);
  }

  .naval__partLead {
    height: 1px;
    border-top: 1px dotted rgba(245, 242, 236, 0.28);
    align-self: center;
  }

  .naval__partMark {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(245, 242, 236, 0.55);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out),
      color 220ms var(--ease-out);
  }

  .naval__part:hover .naval__partMark {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  /* ── tablet ───────────────────────────────────────────── */
  @media (max-width: 960px) {
    .naval {
      padding: var(--space-7) 0;
    }

    .naval__container {
      gap: var(--space-7);
    }

    .naval__top {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .naval__heading {
      max-width: none;
    }

    .naval__plate {
      padding: var(--space-5) var(--space-4) var(--space-6);
    }

    .naval__img {
      max-height: 420px;
    }
  }

  /* ── mobile ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .naval {
      padding: var(--space-6) 0;
    }

    .naval__heading {
      font-size: clamp(1.8rem, 7vw, 2.4rem);
    }

    .naval__meta {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .naval__cote--top,
    .naval__cote--bottom {
      font-size: 0.55rem;
      letter-spacing: 0.16em;
    }

    .naval__cote--right {
      display: none;
    }

    .naval__img {
      max-height: 320px;
    }

    .naval__partsHead {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .naval__partsList {
      grid-template-columns: 1fr;
    }

    .naval__partLabel {
      font-size: 0.74rem;
      letter-spacing: 0.06em;
    }
  }
</style>
