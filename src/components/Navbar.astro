---
import LangToggle from "./LangToggle.astro";
import { resolveLang, useTranslations } from "../i18n/utils";
import type { TranslationKey } from "../i18n/ui";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
const homeHref = lang === "en" ? "/en/" : "/";

const links: Array<{ key: TranslationKey; href: string }> = [
  { key: "nav.services", href: "#servicios" },
  { key: "nav.about", href: "#nosotros" },
  { key: "nav.projects", href: "#proyectos" },
  { key: "nav.contact", href: "#contacto" },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a href={homeHref} class="nav__brand" aria-label={t("nav.brandAria")}>
      <span class="nav__brand-mark">E</span>
      <span class="nav__brand-text">
        <span class="nav__brand-name">
          E<em>nvero</em>
        </span>
        <span class="nav__brand-sub">Marine</span>
      </span>
    </a>

    <nav class="nav__menu" aria-label={t("nav.menuLabel")}>
      <ul>
        {links.map((link, i) => (
          <li>
            <a href={link.href}>
              <span class="nav__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="nav__label">{t(link.key)}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__end">
      <LangToggle />
      <a href="#contacto" class="btn btn--primary nav__cta">
        <span>{t("nav.cta")}</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    height: var(--header-height);
    display: flex;
    align-items: center;
    background-color: var(--color-bg);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .nav__menu a {
    color: var(--color-ink-muted);
  }

  .nav__menu a:hover {
    color: var(--color-ink);
  }

  .nav--scrolled {
    background-color: transparent;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .nav--scrolled .nav__menu a {
    color: rgba(255, 255, 255, 0.85);
  }

  .nav--scrolled .nav__menu a:hover {
    color: var(--color-accent-soft);
  }

  .nav--scrolled .nav__brand-sub {
    opacity: 0.6;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav__brand-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    background-color: var(--color-accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1;
  }

  .nav__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .nav__brand-name {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .nav__brand-name em {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }

  .nav__brand-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-top: 6px;
  }

  .nav__menu ul {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__menu a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    transition: color 0.2s var(--ease-out);
  }

  .nav__menu a:hover {
    color: var(--color-ink);
  }

  .nav__num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-accent);
    opacity: 0.85;
  }

  .nav__end {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
  }

  @media (max-width: 880px) {
    .nav__menu {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .nav__cta {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector(".nav") as HTMLElement;

  const update = () => {
    nav.classList.toggle("nav--scrolled", window.scrollY > 10);
  };

  update();
  window.addEventListener("scroll", update, { passive: true });
</script>
