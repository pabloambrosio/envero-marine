---
import LangToggle from "./LangToggle.astro";
import { resolveLang, useTranslations } from "../i18n/utils";
import type { TranslationKey } from "../i18n/ui";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
const homeHref = lang === "en" ? "/en/" : "/";

const links: Array<{ key: TranslationKey; href: string }> = [
  { key: "nav.services", href: "#servicios" },
  { key: "nav.about", href: "#nosotros" },
  { key: "nav.contact", href: "#contacto" },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a href={homeHref} class="nav__brand" aria-label={t("nav.brandAria")}>
      <img src="/logos/envero.png" alt="Envero Marine" class="nav__brand-img" />
    </a>

    <nav class="nav__menu" aria-label={t("nav.menuLabel")}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>
              <span class="nav__label">{t(link.key)}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__end">
      <LangToggle />
      <button
        type="button"
        class="btn btn--primary nav__cta"
        data-open-modal="appointment"
      >
        <span>{t("nav.cta")}</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    height: var(--header-height);
    display: flex;
    align-items: center;
    background-color: rgba(245, 242, 236, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
  }

  .nav__brand-img {
    display: block;
    height: 48px;
    width: auto;
  }

  .nav__menu ul {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__menu a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    transition: color 0.2s var(--ease-out);
  }

  .nav__menu a:hover {
    color: var(--color-primary);
  }

  .nav__end {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
  }

  @media (max-width: 880px) {
    .nav__menu {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .nav__cta {
      display: none;
    }
  }
</style>
