---
import { resolveLang, useTranslations } from "../i18n/utils";
import BookingWizard from "./booking/BookingWizard.astro";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline

      preload="metadata"
    >
      <source src="/video-herobanner-comprimido.webm" type="video/webm" />
    </video>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <span class="eyebrow hero__eyebrow">{t("hero.eyebrow")}</span>
      <h1 class="hero__title">{t("hero.title")}</h1>
      <ul class="hero__checks" aria-label={t("hero.checks.aria")}>
        <li>{t("hero.checks.local")}</li>
        <li>{t("hero.checks.experts")}</li>
        <li>{t("hero.checks.brands")}</li>
      </ul>

      <div class="hero__actions">
        <a href="#contacto" class="btn btn--primary">
          <span>{t("hero.cta.primary")}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a href="#servicios" class="btn btn--ghost">
          <span>{t("hero.cta.secondary")}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="hero__stats" aria-label={t("hero.stats.aria")}>
        <li>
          <strong>+15</strong>
          <span>{t("hero.stats.experience")}</span>
        </li>
        <li>
          <strong>120</strong>
          <span>{t("hero.stats.projects")}</span>
        </li>
        <li>
          <strong>24/7</strong>
          <span>{t("hero.stats.support")}</span>
        </li>
      </ul>
    </div>

    <div class="hero__aside">
      <BookingWizard />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 80vh;
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: var(--space-9);
    color: #fff;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-primary) 0%, var(--color-primary-deep) 100%);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__bg::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: rgba(10, 42, 36, 0.55);
  }

  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: linear-gradient(
        to right,
        rgba(255, 255, 255, 0.05) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    gap: var(--space-8);
    align-items: center;
  }

  .hero__content {
    max-width: 820px;
  }

  .hero__aside {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      align-items: stretch;
    }
    .hero__aside {
      justify-content: stretch;
    }
  }

  .hero__eyebrow {
    border: 1px solid var(--color-accent);
    padding: 0.35rem 0.65rem;
    background-color: rgba(0, 0, 0, 0.55);
    color: #fff;
  }

  .hero__eyebrow::before {
    display: none;
  }

  .hero__title {
    margin-top: var(--space-5);
    font-size: var(--fs-4xl);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .hero__checks {
    margin-top: var(--space-5);
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 56ch;
  }

  .hero__checks li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.92);
  }

  .hero__checks li::before {
    content: "";
    width: 16px;
    height: 16px;
    flex: none;
    background-color: var(--color-accent);
    background-image: url("data:image/svg+xml;utf8,%3Csvg viewBox='0 0 16 16' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3.5 8.5l3 3 6-6' stroke='white' stroke-width='2.25' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-size: 12px;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero__actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__stats {
    margin-top: var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin-bottom: 0;
    max-width: 720px;
  }

  .hero__stats li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) 0 0;
  }

  .hero__stats li + li {
    border-left: 1px solid rgba(255, 255, 255, 0.14);
    padding-left: var(--space-5);
  }

  .hero__stats strong {
    font-family: var(--font-mono);
    font-size: var(--fs-3xl);
    font-weight: 500;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hero__stats span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 720px) {
    .hero__stats {
      grid-template-columns: 1fr;
    }
    .hero__stats li + li {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      padding-left: 0;
      padding-top: var(--space-4);
    }
  }
</style>
