---
import { sections } from "../data/sections";
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const icons: Record<string, string> = {
  totalenergies: "fa-droplet",
  "current-technology": "fa-bolt",
  qer: "fa-flask",
  fonroche: "fa-solar-panel",
  "estructuras-metalicas": "fa-industry",
  "ingenieria-naval": "fa-ship",
};

const logos: Record<string, string> = {
  totalenergies: "/logos/totalenergies.svg",
  "current-technology": "/logos/current-technology.png",
  fonroche: "/logos/fonroche.webp",
  qer: "/logos/qer.png",
  "estructuras-metalicas": "/logos/envero.png",
  "ingenieria-naval": "/logos/envero.png",
};

const titlesByLang: Record<string, Record<"es" | "en", string>> = {
  "estructuras-metalicas": {
    es: "Fabricación de estructuras metálicas",
    en: "Steel structure fabrication",
  },
  "ingenieria-naval": {
    es: "Arquitectura e ingeniería naval",
    en: "Naval architecture & engineering",
  },
};

const PREVIEW_OFFERINGS = 3;

const modalData = sections.map((section) => ({
  id: section.id,
  title: titlesByLang[section.id]?.[lang] ?? section.title,
  description: section.description[lang],
  isOwnService: section.isOwnService,
  offerings: section.offerings,
  logo: logos[section.id] ?? null,
  iconClass: icons[section.id] ?? "fa-bolt",
  kindLabel: section.isOwnService
    ? t("services.kind.own")
    : t("services.kind.partner"),
}));

const modalLabels = {
  prefillPrefix: t("services.modal.prefillPrefix"),
};
---

<section class="services" id="servicios" aria-label={t("services.aria")}>
  <div class="services__container">
    <header class="services__head">
      <h2 class="services__heading">
        {t("services.heading.lead")}<em class="services__heading-emph">{t("services.heading.emph")}</em>{t("services.heading.tail")}
      </h2>
      <p class="services__lead">{t("services.lead")}</p>
    </header>

    <ul class="services__grid">
      {
        sections.map((section) => {
          const title = titlesByLang[section.id]?.[lang] ?? section.title;
          const preview = section.offerings.slice(0, PREVIEW_OFFERINGS);
          const remaining = section.offerings.length - preview.length;
          const iconClass = icons[section.id] ?? "fa-bolt";
          const logo = logos[section.id];
          return (
            <li
              class={`services__card services__card--${section.isOwnService ? "own" : "partner"}${logo ? " services__card--hasLogo" : ""}`}
            >
              <button
                class="services__link"
                type="button"
                data-section-id={section.id}
                aria-label={title}
                aria-haspopup="dialog"
                aria-controls="services-modal"
              >
                <div class="services__media" aria-hidden="true">
                  {logo ? (
                    <img
                      class="services__logo"
                      src={logo}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <>
                      <span class="services__mediaIcon">
                        <i class={`fa-solid ${iconClass}`} aria-hidden="true" />
                      </span>
                      <span class="services__mediaLabel">{t("services.placeholder")}</span>
                      <span class="services__mediaId">{section.id}</span>
                    </>
                  )}
                </div>

                <div class="services__body">
                  <div class="services__meta">
                    <span class="services__kind">
                      {section.isOwnService
                        ? t("services.kind.own")
                        : t("services.kind.partner")}
                    </span>
                  </div>

                  <h3 class="services__title">{title}</h3>

                  <ol class="services__offerings">
                    {preview.map((offering, oi) => (
                      <li class="services__offering">
                        <span class="services__offeringNum">
                          {String(oi + 1).padStart(2, "0")}
                        </span>
                        <span class="services__offeringText">{offering}</span>
                      </li>
                    ))}
                  </ol>

                  <div class="services__footer">
                    {remaining > 0 ? (
                      <span class="services__more">
                        + {remaining} {t("services.more")}
                      </span>
                    ) : (
                      <span class="services__more services__more--empty" />
                    )}
                    <span class="services__detail">
                      {t("services.viewDetail")}
                      <span class="services__arrow" aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>

  <dialog
    class="services__modal"
    id="services-modal"
    aria-labelledby="services-modal-title"
  >
    <button
      class="services__modalClose"
      type="button"
      data-modal-close
      aria-label={t("services.modal.close")}
    >
      <span aria-hidden="true">×</span>
    </button>

    <header class="services__modalHead">
      <div class="services__modalMedia" aria-hidden="true">
        <span class="services__modalMediaId" data-modal-id />
        <div class="services__modalMediaArt" data-modal-art />
      </div>
      <div class="services__modalIntro">
        <span class="services__modalKind" data-modal-kind />
        <h3 class="services__modalTitle" id="services-modal-title" data-modal-title />
        <p class="services__modalDescription" data-modal-description />
      </div>
    </header>

    <div class="services__modalBody">
      <h4 class="services__modalSubtitle">{t("services.modal.capabilities")}</h4>
      <ol class="services__modalList" data-modal-offerings />
    </div>

    <footer class="services__modalFooter">
      <button class="services__modalCta" type="button" data-modal-cta>
        <span>{t("services.modal.cta")}</span>
        <span class="services__modalArrow" aria-hidden="true">→</span>
      </button>
    </footer>
  </dialog>
</section>

<script is:inline define:vars={{ modalData, modalLabels }}>
  const modal = document.getElementById("services-modal");
  if (modal) {
    const titleEl = modal.querySelector("[data-modal-title]");
    const kindEl = modal.querySelector("[data-modal-kind]");
    const idEl = modal.querySelector("[data-modal-id]");
    const artEl = modal.querySelector("[data-modal-art]");
    const descriptionEl = modal.querySelector("[data-modal-description]");
    const offeringsEl = modal.querySelector("[data-modal-offerings]");
    const ctaEl = modal.querySelector("[data-modal-cta]");
    const closeEl = modal.querySelector("[data-modal-close]");
    const bodyEl = modal.querySelector(".services__modalBody");

    const sectionsMap = new Map(modalData.map((s) => [s.id, s]));
    let activeSection = null;
    let activeCardLogo = null;
    let activeGhost = null;

    function populate(data) {
      modal.dataset.own = data.isOwnService ? "true" : "false";
      titleEl.textContent = data.title;
      kindEl.textContent = data.kindLabel;
      idEl.textContent = data.id;
      descriptionEl.textContent = data.description;
      descriptionEl.hidden = !data.description;

      artEl.innerHTML = "";
      if (data.logo) {
        const img = document.createElement("img");
        img.src = data.logo;
        img.alt = "";
        img.loading = "lazy";
        img.decoding = "async";
        artEl.appendChild(img);
      } else {
        const icon = document.createElement("i");
        icon.className = `fa-solid ${data.iconClass}`;
        icon.setAttribute("aria-hidden", "true");
        artEl.appendChild(icon);
      }

      offeringsEl.innerHTML = "";
      data.offerings.forEach((text, i) => {
        const li = document.createElement("li");
        const num = document.createElement("span");
        num.className = "services__modalNum";
        num.textContent = String(i + 1).padStart(2, "0");
        const txt = document.createElement("span");
        txt.className = "services__modalText";
        txt.textContent = text;
        li.appendChild(num);
        li.appendChild(txt);
        offeringsEl.appendChild(li);
      });

      if (bodyEl) bodyEl.scrollTop = 0;
    }

    document.querySelectorAll("[data-section-id]").forEach((card) => {
      card.addEventListener("click", (event) => {
        event.preventDefault();
        const id = card.dataset.sectionId;
        const data = sectionsMap.get(id);
        if (!data) return;
        activeSection = data;
        populate(data);

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          modal.showModal();
          modal.style.setProperty("--modal-backdrop-opacity", "1");
          return;
        }

        const cardLogo = card.querySelector(".services__logo");
        const cardRect = cardLogo?.getBoundingClientRect();

        modal.showModal();

        const modalImg = artEl.querySelector("img");
        if (cardLogo && cardRect && modalImg) {
          const modalRect = modalImg.getBoundingClientRect();
          const sx = modalRect.width / cardRect.width;
          const sy = modalRect.height / cardRect.height;

          if (activeGhost) activeGhost.remove();

          const ghost = cardLogo.cloneNode(true);
          ghost.style.position = "fixed";
          ghost.style.top = "0";
          ghost.style.left = "0";
          ghost.style.margin = "0";
          ghost.style.width = `${cardRect.width}px`;
          ghost.style.height = `${cardRect.height}px`;
          ghost.style.transformOrigin = "0 0";
          ghost.style.transition = "none";
          ghost.style.transform = `translate(${cardRect.left}px, ${cardRect.top}px)`;
          ghost.style.zIndex = "9999";
          ghost.style.pointerEvents = "none";
          document.body.appendChild(ghost);

          cardLogo.style.visibility = "hidden";
          activeCardLogo = cardLogo;
          activeGhost = ghost;

          ghost.addEventListener("transitionend", () => {
            ghost.remove();
            if (activeGhost === ghost) activeGhost = null;
          }, { once: true });

          requestAnimationFrame(() => {
            ghost.style.transition = "transform 420ms var(--ease-out)";
            ghost.style.transform = `translate(${modalRect.left}px, ${modalRect.top}px) scale(${sx}, ${sy})`;
            setTimeout(() => {
              modal.style.setProperty("--modal-backdrop-opacity", "1");
            }, 280);
          });
        }
      });
    });

    modal.addEventListener("close", () => {
      modal.style.removeProperty("--modal-backdrop-opacity");
      if (activeCardLogo) {
        activeCardLogo.style.visibility = "";
        activeCardLogo = null;
      }
      if (activeGhost) {
        activeGhost.remove();
        activeGhost = null;
      }
    });

    closeEl.addEventListener("click", () => modal.close());

    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });

    ctaEl.addEventListener("click", () => {
      if (!activeSection) return;
      const message = `${modalLabels.prefillPrefix}${activeSection.title}.`;
      modal.close();

      const target = document.getElementById("contacto");
      if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });

      const textarea = document.getElementById("contact-message");
      if (textarea) {
        textarea.value = message;
        window.setTimeout(() => {
          textarea.focus();
          textarea.setSelectionRange(textarea.value.length, textarea.value.length);
        }, 380);
      }
    });
  }
</script>

<style>
  .services {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--space-8) 0;
    background: linear-gradient(
      135deg,
      var(--color-primary-deep) 0%,
      var(--color-primary) 55%,
      var(--color-primary-soft) 100%
    );
    color: #fff;
  }

  .services__container::before,
  .services__container::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 24px;
    background-color: var(--color-primary);
    pointer-events: none;
    z-index: 1;
  }

  .services__container::before {
    top: 0;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .services__container::after {
    bottom: 0;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }

  .services::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    background-attachment: fixed;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    animation: services-grid-drift 5s linear infinite;
  }

  @keyframes services-grid-drift {
    from { background-position: 0 0; }
    to   { background-position: -48px -48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .services::before { animation: none; }
  }

  .services__container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  /* ── header ───────────────────────────────────────────── */
  .services__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    column-gap: var(--space-7);
    row-gap: var(--space-3);
    align-items: end;
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .services__heading {
    margin: 0;
    font-size: clamp(2.25rem, 1.4rem + 2vw, 3.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .services__heading-emph {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.012em;
    color: var(--color-accent);
  }

  .services__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    max-width: 56ch;
  }

  /* ── grid ─────────────────────────────────────────────── */
  .services__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px,100%), 1fr));
    gap: var(--space-5);
  }

  /* ── card ─────────────────────────────────────────────── */
  .services__card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    transition: border-color 200ms var(--ease-out);
  }

  .services__card::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background: transparent;
    transition: background-color 200ms var(--ease-out);
    pointer-events: none;
  }

  .services__card--own::before {
    background: var(--color-accent);
  }

  .services__card:hover {
    border-color: var(--color-primary-soft);
  }

  .services__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    color: inherit;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  .services__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* ── media (placeholder) ──────────────────────────────── */
  .services__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background-color: rgba(14, 61, 52, 0.025);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0,
      transparent 11px,
      rgba(14, 61, 52, 0.06) 11px,
      rgba(14, 61, 52, 0.06) 12px
    );
    border-bottom: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .services__card--hasLogo .services__media {
    background-color: var(--color-surface);
    background-image: none;
    padding: var(--space-5) var(--space-6);
  }

  .services__logo {
    max-width: 70%;
    max-height: 56%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 200ms var(--ease-out);
  }

  .services__card--hasLogo:hover .services__logo {
    transform: scale(1.03);
  }

  .services__mediaIcon {
    color: var(--color-primary);
    opacity: 0.22;
    transition: opacity 200ms var(--ease-out);
  }

  .services__card--own .services__mediaIcon {
    color: var(--color-accent);
    opacity: 0.32;
  }

  .services__card:hover .services__mediaIcon {
    opacity: 0.4;
  }

  .services__mediaIcon :global(.fa-solid) {
    font-size: 3.25rem;
    line-height: 1;
  }

  .services__mediaLabel {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--color-ink-muted);
    opacity: 0.7;
  }

  .services__mediaId {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    opacity: 0.55;
    text-transform: uppercase;
  }

  /* ── body ─────────────────────────────────────────────── */
  .services__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    flex: 1 1 auto;
  }

  .services__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .services__kind {
    color: var(--color-ink-muted);
  }

  .services__card--own .services__kind {
    color: var(--color-accent);
  }

  .services__title {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-primary);
  }

  /* ── offerings list ───────────────────────────────────── */
  .services__offerings {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .services__offering {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .services__offeringNum {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .services__offeringText {
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--color-ink);
  }

  /* ── footer ───────────────────────────────────────────── */
  .services__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .services__more {
    color: var(--color-ink-muted);
  }

  .services__more--empty {
    visibility: hidden;
  }

  .services__detail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-primary);
  }

  .services__arrow {
    display: inline-block;
    color: var(--color-ink-muted);
    transition: transform 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .services__card:hover .services__arrow {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  /* ── modal ────────────────────────────────────────────── */
  .services__modal {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    width: min(720px, calc(100vw - 2 * var(--space-5)));
    max-height: min(86vh, 100%);
    background: var(--color-surface);
    color: var(--color-ink);
    border: 1px solid var(--color-primary);
    box-shadow: 0 24px 48px rgba(10, 42, 36, 0.18);
    opacity: var(--modal-backdrop-opacity, 0);
    transition: opacity 280ms var(--ease-out);
  }

  .services__modal::backdrop {
    background: rgba(10, 42, 36, 0.72);
    opacity: var(--modal-backdrop-opacity, 0);
    transition: opacity 280ms var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .services__modal,
    .services__modal::backdrop {
      transition: none;
    }
  }

  .services__modal[open] {
    display: flex;
    flex-direction: column;
  }

  .services__modal[data-own="true"]::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    pointer-events: none;
  }

  .services__modalClose {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 3;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    color: var(--color-primary);
    opacity: 0.55;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: opacity 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .services__modalClose:hover {
    opacity: 1;
    color: var(--color-primary);
  }

  .services__modalHead {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    border-bottom: 1px solid var(--color-line);
  }

  .services__modalMedia {
    position: relative;
    min-height: 220px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(
        ellipse at 50% 45%,
        rgba(255, 255, 255, 0.85) 0%,
        rgba(255, 255, 255, 0) 62%
      ),
      var(--color-bg);
    border-right: 1px solid var(--color-line);
    overflow: hidden;
  }

  .services__modalMedia::before {
    content: "";
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    width: 10px;
    height: 10px;
    border-bottom: 1px solid var(--color-primary);
    border-left: 1px solid var(--color-primary);
    opacity: 0.45;
    pointer-events: none;
  }

  .services__modal[data-own="true"] .services__modalMedia::before {
    border-color: var(--color-accent);
    opacity: 0.7;
  }

  .services__modalMediaId {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    opacity: 0.55;
    pointer-events: none;
    z-index: 1;
  }

  .services__modalMediaArt {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: var(--space-4);
  }

  .services__modalMediaArt img {
    max-width: 86%;
    max-height: 78%;
    width: auto;
    height: auto;
    object-fit: contain;
