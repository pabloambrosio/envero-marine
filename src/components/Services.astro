---
import { sections } from "../data/sections";
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const icons: Record<string, string> = {
  totalenergies: "fa-droplet",
  "current-technology": "fa-bolt",
  qer: "fa-flask",
  fonroche: "fa-solar-panel",
  "estructuras-metalicas": "fa-industry",
  "ingenieria-naval": "fa-ship",
};

const logos: Record<string, string> = {
  totalenergies: "/logos/totalenergies.svg",
  "current-technology": "/logos/current-technology.png",
  fonroche: "/logos/fonroche.webp",
  qer: "/logos/qer.png",
  "estructuras-metalicas": "/logos/envero.png",
  "ingenieria-naval": "/logos/envero.png",
};

const titlesByLang: Record<string, Record<"es" | "en", string>> = {
  "estructuras-metalicas": {
    es: "Fabricación de estructuras metálicas",
    en: "Steel structure fabrication",
  },
  "ingenieria-naval": {
    es: "Arquitectura e ingeniería naval",
    en: "Naval architecture & engineering",
  },
};

const PREVIEW_OFFERINGS = 3;
---

<section class="services" id="servicios" aria-label={t("services.aria")}>
  <div class="services__container">
    <header class="services__head">
      <h2 class="services__heading">{t("services.heading")}</h2>
      <p class="services__lead">{t("services.lead")}</p>
    </header>

    <ul class="services__grid">
      {
        sections.map((section) => {
          const title = titlesByLang[section.id]?.[lang] ?? section.title;
          const preview = section.offerings.slice(0, PREVIEW_OFFERINGS);
          const remaining = section.offerings.length - preview.length;
          const iconClass = icons[section.id] ?? "fa-bolt";
          const logo = logos[section.id];
          return (
            <li
              class={`services__card services__card--${section.isOwnService ? "own" : "partner"}${logo ? " services__card--hasLogo" : ""}`}
              data-section-id={section.id}
            >
              <a class="services__link" href={`#${section.id}`} aria-label={title}>
                <div class="services__media" aria-hidden="true">
                  {logo ? (
                    <img
                      class="services__logo"
                      src={logo}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <>
                      <span class="services__mediaIcon">
                        <i class={`fa-solid ${iconClass}`} aria-hidden="true" />
                      </span>
                      <span class="services__mediaLabel">{t("services.placeholder")}</span>
                      <span class="services__mediaId">{section.id}</span>
                    </>
                  )}
                </div>

                <div class="services__body">
                  <div class="services__meta">
                    <span class="services__kind">
                      {section.isOwnService
                        ? t("services.kind.own")
                        : t("services.kind.partner")}
                    </span>
                  </div>

                  <h3 class="services__title">{title}</h3>

                  <ol class="services__offerings">
                    {preview.map((offering, oi) => (
                      <li class="services__offering">
                        <span class="services__offeringNum">
                          {String(oi + 1).padStart(2, "0")}
                        </span>
                        <span class="services__offeringText">{offering}</span>
                      </li>
                    ))}
                  </ol>

                  <div class="services__footer">
                    {remaining > 0 ? (
                      <span class="services__more">
                        + {remaining} {t("services.more")}
                      </span>
                    ) : (
                      <span class="services__more services__more--empty" />
                    )}
                    <span class="services__detail">
                      {t("services.viewDetail")}
                      <span class="services__arrow" aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .services {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .services__container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  /* ── header ───────────────────────────────────────────── */
  .services__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    column-gap: var(--space-7);
    row-gap: var(--space-3);
    align-items: end;
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  .services__heading {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .services__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 56ch;
  }

  /* ── grid ─────────────────────────────────────────────── */
  .services__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  /* ── card ─────────────────────────────────────────────── */
  .services__card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    transition: border-color 200ms var(--ease-out);
  }

  .services__card::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background: transparent;
    transition: background-color 200ms var(--ease-out);
    pointer-events: none;
  }

  .services__card--own::before {
    background: var(--color-accent);
  }

  .services__card:hover {
    border-color: var(--color-primary-soft);
  }

  .services__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
  }

  /* ── media (placeholder) ──────────────────────────────── */
  .services__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background-color: rgba(14, 61, 52, 0.025);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0,
      transparent 11px,
      rgba(14, 61, 52, 0.06) 11px,
      rgba(14, 61, 52, 0.06) 12px
    );
    border-bottom: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .services__card--hasLogo .services__media {
    background-color: var(--color-surface);
    background-image: none;
    padding: var(--space-5) var(--space-6);
  }

  .services__logo {
    max-width: 70%;
    max-height: 56%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 200ms var(--ease-out);
  }

  .services__card--hasLogo:hover .services__logo {
    transform: scale(1.03);
  }

  .services__mediaIcon {
    color: var(--color-primary);
    opacity: 0.22;
    transition: opacity 200ms var(--ease-out);
  }

  .services__card--own .services__mediaIcon {
    color: var(--color-accent);
    opacity: 0.32;
  }

  .services__card:hover .services__mediaIcon {
    opacity: 0.4;
  }

  .services__mediaIcon :global(.fa-solid) {
    font-size: 3.25rem;
    line-height: 1;
  }

  .services__mediaLabel {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--color-ink-muted);
    opacity: 0.7;
  }

  .services__mediaId {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    opacity: 0.55;
    text-transform: uppercase;
  }

  /* ── body ─────────────────────────────────────────────── */
  .services__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    flex: 1 1 auto;
  }

  .services__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .services__kind {
    color: var(--color-ink-muted);
  }

  .services__card--own .services__kind {
    color: var(--color-accent);
  }

  .services__title {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-primary);
  }

  /* ── offerings list ───────────────────────────────────── */
  .services__offerings {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .services__offering {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .services__offeringNum {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .services__offeringText {
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--color-ink);
  }

  /* ── footer ───────────────────────────────────────────── */
  .services__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .services__more {
    color: var(--color-ink-muted);
  }

  .services__more--empty {
    visibility: hidden;
  }

  .services__detail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-primary);
  }

  .services__arrow {
    display: inline-block;
    color: var(--color-ink-muted);
    transition: transform 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .services__card:hover .services__arrow {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  /* ── tablet ───────────────────────────────────────────── */
  @media (max-width: 960px) {
    .services {
      padding: var(--space-7) 0;
    }

    .services__head {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }

    .services__heading {
      font-size: var(--fs-xl);
    }

    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }

    .services__mediaIcon :global(.fa-solid) {
      font-size: 2.75rem;
    }
  }

  /* ── mobile ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .services {
      padding: var(--space-6) 0;
    }

    .services__head {
      margin-bottom: var(--space-5);
      padding-bottom: var(--space-4);
    }

    .services__heading {
      font-size: var(--fs-lg);
    }

    .services__lead {
      font-size: var(--fs-sm);
    }

    .services__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .services__body {
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .services__title {
      font-size: var(--fs-md);
    }

    .services__mediaIcon :global(.fa-solid) {
      font-size: 2.5rem;
    }
  }
</style>
