---
import { reasons } from "../data/reasons";
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const icons: Record<string, string> = {
  badge: "fa-certificate",
  layers: "fa-layer-group",
  compass: "fa-location-dot",
  shield: "fa-shield-halved",
  sun: "fa-solar-panel",
  anchor: "fa-anchor",
  structure: "fa-industry",
};
---

<section class="reasons">
  <div class="reasons__layout">
    <header class="reasons__head">
      <p class="reasons__eyebrow">{t("reasons.eyebrow")}</p>
      <h2 class="reasons__heading">{t("reasons.heading")}</h2>
      <p class="reasons__lead">{t("reasons.lead")}</p>
    </header>

    <div class="reasons__viewport" tabindex="0" aria-label={t("reasons.aria")}>
      <ul class="reasons__track">
        {
          reasons.map((reason, i) => {
            const iconClass = icons[reason.icon ?? "badge"] ?? icons.badge;
            const index = String(i + 1).padStart(2, "0");
            return (
              <li class="reasons__card" data-badge={reason.badgeColor ?? "neutral"}>
                <div class="reasons__cardHead">
                  <span class="reasons__index">[ {index} ]</span>
                  <span class="reasons__icon" aria-hidden="true">
                    <i class={`fa-solid ${iconClass}`} aria-hidden="true" />
                  </span>
                </div>
                <h3 class="reasons__title">
                  <span>{reason.title[lang]}</span>
                  <span class="reasons__arrow" aria-hidden="true">→</span>
                </h3>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .reasons {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
    overflow: hidden;
  }

  .reasons__layout {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    padding-left: max(var(--space-5), calc((100vw - var(--container-max)) / 2 + var(--space-5)));
  }

  .reasons__head {
    padding-block: var(--space-3) var(--space-5);
    padding-right: var(--space-5);
  }

  .reasons__eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .reasons__heading {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-primary);
  }

  .reasons__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .reasons__viewport {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .reasons__viewport::-webkit-scrollbar {
    height: 6px;
  }

  .reasons__viewport::-webkit-scrollbar-track {
    background: transparent;
  }

  .reasons__viewport::-webkit-scrollbar-thumb {
    background: var(--color-line);
  }

  .reasons__track {
    list-style: none;
    margin: 0;
    padding: var(--space-3) var(--space-7) var(--space-3) 0;
    display: flex;
    gap: var(--space-5);
    width: max-content;
  }

  .reasons__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 0 0 360px;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: var(--space-5);
    scroll-snap-align: start;
    transition: border-color 200ms var(--ease-out);
  }

  .reasons__card:hover {
    border-color: var(--color-primary-soft);
  }

  .reasons__cardHead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .reasons__index {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .reasons__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--color-line);
    color: var(--color-primary);
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }

  .reasons__icon :global(.fa-solid) {
    font-size: 1.5rem;
    line-height: 1;
  }

  .reasons__card[data-badge="accent"] .reasons__icon {
    color: var(--color-accent);
  }

  .reasons__card[data-badge="neutral"] .reasons__icon {
    color: var(--color-ink);
  }

  .reasons__card:hover .reasons__icon {
    border-color: var(--color-primary-soft);
  }

  .reasons__title {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-primary);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .reasons__arrow {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-ink-muted);
    transition: transform 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .reasons__card:hover .reasons__arrow {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  /* ── tablet ─────────────────────────────────────────── */
  @media (max-width: 960px) {
    .reasons {
      padding: var(--space-7) 0;
    }

    .reasons__layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-left: max(var(--space-5), calc((100vw - var(--container-max)) / 2 + var(--space-5)));
    }

    .reasons__head {
      max-width: 640px;
      padding-block: 0;
      padding-right: max(var(--space-5), calc((100vw - var(--container-max)) / 2 + var(--space-5)));
    }

    .reasons__heading {
      font-size: var(--fs-xl);
    }

    .reasons__track {
      padding: var(--space-2) var(--space-5) var(--space-2) 0;
      gap: var(--space-4);
    }

    .reasons__card {
      flex-basis: 320px;
    }
  }

  /* ── mobile ─────────────────────────────────────────── */
  @media (max-width: 640px) {
    .reasons {
      padding: var(--space-6) 0;
    }

    .reasons__layout {
      gap: var(--space-5);
    }

    .reasons__eyebrow {
      margin-bottom: var(--space-3);
    }

    .reasons__heading {
      font-size: var(--fs-lg);
      margin-bottom: var(--space-4);
    }

    .reasons__lead {
      font-size: var(--fs-sm);
    }

    .reasons__card {
      flex-basis: 260px;
      aspect-ratio: 5 / 4;
      padding: var(--space-4);
    }

    .reasons__icon {
      width: 44px;
      height: 44px;
    }

    .reasons__icon :global(.fa-solid) {
      font-size: 1.2rem;
    }

    .reasons__title {
      font-size: var(--fs-md);
      padding-top: var(--space-3);
    }
  }
</style>
