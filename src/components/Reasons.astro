---
import { reasons } from "../data/reasons";
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const icons: Record<string, string> = {
  badge: "fa-certificate",
  layers: "fa-layer-group",
  compass: "fa-location-dot",
  shield: "fa-shield-halved",
  sun: "fa-solar-panel",
  anchor: "fa-anchor",
  structure: "fa-industry",
};
---

<section class="reasons">
  <div class="reasons__layout">
    <header class="reasons__head">
      <p class="reasons__eyebrow">{t("reasons.eyebrow")}</p>
      <h2 class="reasons__heading">{t("reasons.heading")}</h2>
      <p class="reasons__lead">{t("reasons.lead")}</p>
    </header>

    <div class="reasons__viewport" tabindex="0" aria-label={t("reasons.aria")}>
      <ul class="reasons__track">
        {
          reasons.map((reason) => {
            const iconClass = icons[reason.icon ?? "badge"] ?? icons.badge;
            return (
              <li class={`reasons__card${reason.title[lang].length > 50 ? ' reasons__card--long-title' : ''}`} data-badge={reason.badgeColor ?? "neutral"}>
                <div class="reasons__cardFront">
                  <div class="reasons__cardHead">
                    <span class="reasons__icon" aria-hidden="true">
                      <i class={`fa-solid ${iconClass}`} aria-hidden="true" />
                    </span>
                  </div>
                  <h3 class="reasons__title">
                    <span>{reason.title[lang]}</span>
                    <span class="reasons__arrow" aria-hidden="true">→</span>
                  </h3>
                </div>
                <div class="reasons__cardReveal">
                  <p class={`reasons__content${reason.content.length > 176 ? ' reasons__content--long' : ''}`}>{reason.content}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .reasons {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
    overflow: hidden;
  }

  .reasons__layout {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    margin-left: max(var(--space-3), calc((100vw - var(--container-max)) / 4 + var(--space-3)));
    padding-left: max(var(--space-4), calc((100vw - var(--container-max)) / 4 + var(--space-4)));
    padding-block: var(--space-6);
    background-color: #EAE7DF;
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
  }

  .reasons__head {
    padding-block: var(--space-4) var(--space-5);
    padding-right: var(--space-6);
  }

  .reasons__eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .reasons__heading {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-primary);
  }

  .reasons__lead {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .reasons__viewport {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .reasons__viewport::-webkit-scrollbar {
    height: 6px;
  }

  .reasons__viewport::-webkit-scrollbar-track {
    background: transparent;
  }

  .reasons__viewport::-webkit-scrollbar-thumb {
    background: var(--color-line);
  }

  .reasons__track {
    list-style: none;
    margin: 0;
    padding: var(--space-3) var(--space-7) var(--space-3) 0;
    display: flex;
    gap: var(--space-5);
    width: max-content;
  }

  .reasons__card {
    position: relative;
    overflow: hidden;
    flex: 0 0 360px;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-surface);
    scroll-snap-align: start;
    transition: border-color 200ms var(--ease-out);
  }

  .reasons__card:hover {
    border-color: var(--color-primary-soft);
  }

  .reasons__cardFront,
  .reasons__cardReveal {
    position: absolute;
    inset: 0;
    padding: var(--space-6);
  }

  .reasons__cardFront {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateY(0);
    /* transition: transform 240ms cubic-bezier(0.4, 0, 1, 1); */
    transition: transform 400ms var(--ease-spring) 30ms;
  }

  .reasons__cardReveal {
    transform: translateY(100%);
    background: var(--color-primary);
    border-radius: 8px 8px 0 0;
    transition: transform 400ms var(--ease-spring) 30ms;
  }

  .reasons__content {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: rgba(245, 242, 236, 0.75);
  }

  .reasons__content--long {
    font-size: var(--fs-xs);
  }

  .reasons__card:hover .reasons__cardFront {
    transform: translateY(-60%);
  }

  .reasons__card:hover .reasons__cardReveal {
    transform: translateY(35%);
  }

  .reasons__cardHead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .reasons__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    color: var(--color-primary);
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }

  .reasons__icon :global(.fa-solid) {
    font-size: 1.5rem;
    line-height: 1;
  }

  .reasons__card[data-badge="accent"] .reasons__icon {
    color: var(--color-accent);
  }

  .reasons__card[data-badge="neutral"] .reasons__icon {
    color: var(--color-ink);
  }

  .reasons__card:hover .reasons__icon {
    border-color: var(--color-primary-soft);
  }

  .reasons__title {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-primary);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .reasons__arrow {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-ink-muted);
    transition: transform 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .reasons__card:hover .reasons__arrow {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  .reasons__card--long-title .reasons__title {
    font-size: var(--fs-md);
  }

  /* ── tablet ─────────────────────────────────────────── */
  @media (max-width: 960px) {
    .reasons {
      padding: var(--space-7) 0;
    }

    .reasons__layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-left: max(var(--space-5), calc((100vw - var(--container-max)) / 2 + var(--space-5)));
    }

    .reasons__head {
      max-width: 640px;
      padding-block: 0;
      padding-right: max(var(--space-5), calc((100vw - var(--container-max)) / 2 + var(--space-5)));
    }

    .reasons__heading {
      font-size: var(--fs-xl);
    }

    .reasons__track {
      padding: var(--space-2) var(--space-5) var(--space-2) 0;
      gap: var(--space-4);
    }

    .reasons__card {
      flex-basis: 320px;
    }

    .reasons__cardFront,
    .reasons__cardReveal {
      padding: var(--space-5);
    }
  }

  /* ── mobile ─────────────────────────────────────────── */
  @media (max-width: 640px) {
    .reasons {
      padding: var(--space-6) 0;
    }

    .reasons__layout {
      gap: var(--space-5);
    }

    .reasons__eyebrow {
      margin-bottom: var(--space-3);
    }

    .reasons__heading {
      font-size: var(--fs-lg);
      margin-bottom: var(--space-4);
    }

    .reasons__lead {
      font-size: var(--fs-sm);
    }

    .reasons__card {
      flex-basis: 260px;
      aspect-ratio: 5 / 4;
    }

    .reasons__cardFront,
    .reasons__cardReveal {
      padding: var(--space-4);
    }

    .reasons__icon {
      width: 44px;
      height: 44px;
    }

    .reasons__icon :global(.fa-solid) {
      font-size: 1.2rem;
    }

    .reasons__title {
      font-size: var(--fs-md);
      padding-top: var(--space-3);
    }
  }
</style>
