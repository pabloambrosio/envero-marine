// Schema MySQL del sitio. Equivalente 1:1 del squash de Supabase
// (appointment + message) más las tablas de auth propia (user + session).
// Decisiones en docs/plans/2026-08-11-mysql-repository-pattern-design.md.
//
// El client se genera en src/generated/prisma (gitignored, lo regenera
// `postinstall`). Sin engines Rust: Prisma 7 + @prisma/adapter-mariadb.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
}

model Appointment {
  id              String            @id @default(uuid()) @db.Char(36)
  name            String            @db.VarChar(255)
  email           String?           @db.VarChar(255)
  phone           String            @db.VarChar(64)
  companyName     String?           @map("company_name") @db.VarChar(255)
  appointmentDate DateTime          @map("appointment_date")
  status          AppointmentStatus @default(pending)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([appointmentDate])
  @@map("appointment")
}

model Message {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(64)
  companyName String?  @map("company_name") @db.VarChar(255)
  message     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("message")
}

enum UserRole {
  admin
  staff
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(255)
  name         String    @default("") @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(staff)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@map("user")
}

model Session {
  // id = SHA-256 hex del token de sesión. El token en claro solo viaja en la
  // cookie; un dump de la DB no regala sesiones.
  id        String   @id @db.Char(64)
  userId    String   @map("user_id") @db.Char(36)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}
